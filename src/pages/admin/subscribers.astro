---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getNewsletterSubscribers } from '@/utils/supabase';

const subscribers = await getNewsletterSubscribers();
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || 'https://rgbnwbeyrjxmgmamwdgd.supabase.co';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_SERVICE_ROLE_KEY || '';
---

<AdminLayout title="Wanaofuatilia Jarida (Newsletter Subscribers)" activeNav="subscribers">
  <div class="space-y-6">
    {/* Page Header */}
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-dark-green sm:text-3xl">
          Wanaofuatilia Jarida (Newsletter Subscribers)
        </h1>
        <p class="mt-1 text-sm text-text-muted">
          Simamia orodha ya wasomaji wanaopokea nakala na vidokezo vya afya kupitia barua pepe.
        </p>
      </div>

      <div class="flex items-center gap-2.5">
        <button
          type="button"
          id="export-csv-btn"
          class="inline-flex items-center gap-2 rounded-xl border border-border bg-white px-3.5 py-2.5 text-xs font-bold text-dark-green shadow-2xs hover:bg-primary-soft transition cursor-pointer"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          Pakua CSV (Export)
        </button>

        <button
          type="button"
          id="open-modal-btn"
          class="inline-flex items-center gap-2 rounded-xl bg-dark-green px-4 py-2.5 text-xs font-bold text-white shadow-sm transition hover:bg-accent cursor-pointer"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
          </svg>
          Ongeza Msomaji (Add)
        </button>
      </div>
    </div>

    {/* Metric Cards */}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="rounded-2xl border border-border bg-white p-4 shadow-2xs">
        <div class="text-xs font-bold text-text-muted">Jumla ya Wasomaji</div>
        <div class="text-2xl font-extrabold text-dark-green mt-1">{subscribers.length}</div>
      </div>
      <div class="rounded-2xl border border-border bg-white p-4 shadow-2xs">
        <div class="text-xs font-bold text-text-muted">Wanaopokea Sasa (Active)</div>
        <div class="text-2xl font-extrabold text-emerald-600 mt-1">
          {subscribers.filter(s => s.is_active).length}
        </div>
      </div>
      <div class="rounded-2xl border border-border bg-white p-4 shadow-2xs">
        <div class="text-xs font-bold text-text-muted">Waliojitoa (Unsubscribed)</div>
        <div class="text-2xl font-extrabold text-text-muted mt-1">
          {subscribers.filter(s => !s.is_active).length}
        </div>
      </div>
    </div>

    {/* Subscribers Table */}
    <div class="rounded-2xl border border-border bg-white shadow-2xs overflow-hidden">
      <div class="p-4 border-b border-border bg-bg flex items-center justify-between">
        <span class="text-xs font-bold text-text-muted uppercase tracking-wider">
          Orodha ya Barua Pepe ({subscribers.length})
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-start text-sm">
          <thead class="bg-white text-xs font-bold uppercase tracking-wider text-text-muted border-b border-border">
            <tr>
              <th class="px-6 py-3.5 text-start">Barua Pepe (Email)</th>
              <th class="px-6 py-3.5 text-start">Jina (Name)</th>
              <th class="px-6 py-3.5 text-start">Chanzo (Source)</th>
              <th class="px-6 py-3.5 text-start">Hali (Status)</th>
              <th class="px-6 py-3.5 text-start">Tarehe</th>
              <th class="px-6 py-3.5 text-end">Vitendo</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {subscribers.length === 0 ? (
              <tr>
                <td colspan="6" class="px-6 py-8 text-center text-xs text-text-muted">
                  Hakuna wasomaji waliojisajili bado.
                </td>
              </tr>
            ) : (
              subscribers.map(sub => (
                <tr class="hover:bg-primary-soft/20 transition" data-id={sub.id}>
                  <td class="px-6 py-4 font-bold text-dark-green">
                    {sub.email}
                  </td>
                  <td class="px-6 py-4 text-xs text-text-muted">
                    {sub.name || '—'}
                  </td>
                  <td class="px-6 py-4 text-xs font-semibold">
                    <span class="rounded-md bg-bg border border-border px-2 py-0.5 text-text-muted">
                      {sub.source || 'Website'}
                    </span>
                  </td>
                  <td class="px-6 py-4">
                    <span
                      class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-bold ${
                        sub.is_active
                          ? 'bg-emerald-100 text-emerald-800'
                          : 'bg-neutral-100 text-neutral-600'
                      }`}
                    >
                      <span class={`size-1.5 rounded-full ${sub.is_active ? 'bg-emerald-600' : 'bg-neutral-400'}`}></span>
                      {sub.is_active ? 'Inafanya Kazi' : 'Amejitoa'}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-xs text-text-muted">
                    {sub.subscribed_at ? new Date(sub.subscribed_at).toLocaleDateString('sw-TZ') : '—'}
                  </td>
                  <td class="px-6 py-4 text-end">
                    <button
                      type="button"
                      class="delete-sub-btn rounded-lg border border-red-200 bg-white px-2.5 py-1.5 text-xs font-bold text-red-600 hover:bg-red-50 transition cursor-pointer"
                      data-id={sub.id}
                      data-email={sub.email}
                    >
                      Futa
                    </button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  {/* Add Subscriber Modal */}
  <div id="add-modal" class="fixed inset-0 z-50 hidden bg-text/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="relative w-full max-w-md rounded-3xl bg-white p-6 shadow-2xl border border-border">
      <div class="flex items-center justify-between border-b border-border pb-3">
        <h2 class="text-base font-extrabold text-dark-green">Ongeza Msomaji Mpya</h2>
        <button type="button" id="close-modal-btn" class="size-7 rounded-full border border-border text-text-muted flex items-center justify-center cursor-pointer">✕</button>
      </div>

      <form id="add-sub-form" class="mt-4 space-y-4">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-text">Barua Pepe (Email) *</label>
          <input
            type="email"
            id="sub-email"
            required
            placeholder="msomaji@example.com"
            class="mt-1 block w-full rounded-xl border border-border bg-bg px-3.5 py-2 text-sm text-text focus:outline-none focus:border-accent"
          />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-text">Jina (Hiari)</label>
          <input
            type="text"
            id="sub-name"
            placeholder="mf. Juma Hamisi"
            class="mt-1 block w-full rounded-xl border border-border bg-bg px-3.5 py-2 text-sm text-text focus:outline-none focus:border-accent"
          />
        </div>

        <div class="pt-2 flex justify-end gap-2 border-t border-border">
          <button type="button" id="cancel-modal-btn" class="px-4 py-2 text-xs font-bold text-text-muted hover:text-text cursor-pointer">Ghairi</button>
          <button type="submit" id="save-sub-btn" class="rounded-xl bg-dark-green px-5 py-2 text-xs font-bold text-white hover:bg-accent transition cursor-pointer">Hifadhi</button>
        </div>
      </form>
    </div>
  </div>

  <script define:vars={{ supabaseUrl, supabaseKey, subscribers }}>
    // Modal toggle
    const modal = document.getElementById('add-modal');
    document.getElementById('open-modal-btn')?.addEventListener('click', () => modal?.classList.remove('hidden'));
    document.getElementById('close-modal-btn')?.addEventListener('click', () => modal?.classList.add('hidden'));
    document.getElementById('cancel-modal-btn')?.addEventListener('click', () => modal?.classList.add('hidden'));

    // Export CSV
    document.getElementById('export-csv-btn')?.addEventListener('click', () => {
      let csvContent = "data:text/csv;charset=utf-8,Email,Name,Source,Status,SubscribedAt\n";
      subscribers.forEach(s => {
        csvContent += `"${s.email}","${s.name || ''}","${s.source || 'Website'}","${s.is_active ? 'Active' : 'Unsubscribed'}","${s.subscribed_at || ''}"\n`;
      });
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", `healthtalks_subscribers_${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });

    // Add Subscriber
    document.getElementById('add-sub-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('sub-email')?.value.trim();
      const name = document.getElementById('sub-name')?.value.trim();

      if (!email) return;

      try {
        const res = await fetch(`${supabaseUrl}/rest/v1/newsletter_subscribers`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'apikey': supabaseKey,
            'Authorization': `Bearer ${supabaseKey}`,
          },
          body: JSON.stringify({
            email,
            name: name || null,
            is_active: true,
            source: 'Admin Portal',
            subscribed_at: new Date().toISOString(),
          }),
        });

        if (res.ok) {
          alert('Msomaji ameongezwa!');
          window.location.reload();
        } else {
          alert('Haikuweza kuongeza. Huenda barua pepe hii tayari ipo.');
        }
      } catch (err) {
        console.error(err);
        alert('Hitilafu ya mtandao.');
      }
    });

    // Delete Subscriber
    document.querySelectorAll('.delete-sub-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const email = btn.getAttribute('data-email');
        if (!confirm(`Je, una uhakika unataka kumfuta msomaji "${email}"?`)) return;

        try {
          const res = await fetch(`${supabaseUrl}/rest/v1/newsletter_subscribers?id=eq.${id}`, {
            method: 'DELETE',
            headers: {
              'apikey': supabaseKey,
              'Authorization': `Bearer ${supabaseKey}`,
            },
          });
          if (res.ok) {
            document.querySelector(`tr[data-id="${id}"]`)?.remove();
          } else {
            alert('Haikuweza kufuta.');
          }
        } catch (err) {
          console.error(err);
          alert('Hitilafu ya mtandao.');
        }
      });
    });
  </script>
</AdminLayout>

