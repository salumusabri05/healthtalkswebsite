---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getFeatures } from '@/utils/supabase';

const features = await getFeatures();
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || 'https://rgbnwbeyrjxmgmamwdgd.supabase.co';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_SERVICE_ROLE_KEY || '';
---

<AdminLayout title="Vipengele vya Jukwaa (Platform Features)" activeNav="features">
  <div class="space-y-6">
    {/* Page Header */}
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-dark-green sm:text-3xl">
          Vipengele vya Jukwaa (Platform Features)
        </h1>
        <p class="mt-1 text-sm text-text-muted">
          Simamia nguzo na huduma kuu za HealthTalks zinazoonekana kwa wasomaji.
        </p>
      </div>

      <button
        type="button"
        id="open-feature-modal-btn"
        class="inline-flex items-center gap-2 rounded-xl bg-dark-green px-4 py-2.5 text-xs font-bold text-white shadow-sm transition hover:bg-accent cursor-pointer"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="12" y1="5" x2="12" y2="19" />
          <line x1="5" y1="12" x2="19" y2="12" />
        </svg>
        Ongeza Kipengele (New Feature)
      </button>
    </div>

    {/* Features Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {features.map((feat) => (
        <div class="rounded-2xl border border-border bg-white p-6 shadow-2xs flex flex-col justify-between" data-id={feat.id}>
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-border/60">
              <span class="rounded-lg bg-primary-soft px-2.5 py-1 text-xs font-bold text-dark-green border border-border">
                Nafasi #{feat.display_order ?? '—'}
              </span>
              <span class="text-xs font-mono text-text-muted bg-bg px-2 py-0.5 rounded border border-border">
                {feat.icon || 'star'}
              </span>
            </div>

            <h3 class="mt-4 text-lg font-extrabold text-dark-green">
              {feat.title}
            </h3>

            <p class="mt-2 text-sm text-text-muted leading-relaxed">
              {feat.description}
            </p>

            {feat.image_url && (
              <img src={feat.image_url} alt={feat.title} class="mt-4 h-32 w-full object-cover rounded-xl border border-border" />
            )}
          </div>

          <div class="mt-6 flex items-center justify-end gap-2 border-t border-border/60 pt-4">
            <button
              type="button"
              class="edit-feature-btn rounded-lg border border-border bg-white px-3 py-1.5 text-xs font-bold text-dark-green hover:bg-primary-soft transition cursor-pointer"
              data-feature={JSON.stringify(feat)}
            >
              Hariri
            </button>
            <button
              type="button"
              class="delete-feature-btn rounded-lg border border-red-200 bg-white px-3 py-1.5 text-xs font-bold text-red-600 hover:bg-red-50 transition cursor-pointer"
              data-id={feat.id}
              data-title={feat.title}
            >
              Futa
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>

  {/* Feature Modal */}
  <div id="feature-modal" class="fixed inset-0 z-50 hidden bg-text/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="relative w-full max-w-lg rounded-3xl bg-white p-6 shadow-2xl border border-border">
      <div class="flex items-center justify-between border-b border-border pb-3">
        <h2 id="feature-modal-title" class="text-base font-extrabold text-dark-green">Ongeza Kipengele</h2>
        <button type="button" id="close-feature-modal-btn" class="size-7 rounded-full border border-border text-text-muted flex items-center justify-center cursor-pointer">✕</button>
      </div>

      <form id="feature-form" class="mt-4 space-y-4">
        <input type="hidden" id="feature-id" value="" />

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-text">Kichwa cha Kipengele (Title) *</label>
          <input
            type="text"
            id="feature-title"
            required
            placeholder="mf. Elimu ya Afya"
            class="mt-1 block w-full rounded-xl border border-border bg-bg px-3.5 py-2 text-sm text-text focus:outline-none focus:border-accent"
          />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-text">Maelezo (Description) *</label>
          <textarea
            id="feature-desc"
            required
            rows="3"
            placeholder="Maelezo mafupi ya kipengele hiki..."
            class="mt-1 block w-full rounded-xl border border-border bg-bg px-3.5 py-2 text-sm text-text focus:outline-none focus:border-accent"
          ></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-text">Aikoni (Icon name)</label>
            <input
              type="text"
              id="feature-icon"
              placeholder="medical_services, verified, school"
              class="mt-1 block w-full rounded-xl border border-border bg-bg px-3.5 py-2 text-sm text-text focus:outline-none focus:border-accent"
            />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-text">Nafasi (Display Order)</label>
            <input
              type="number"
              id="feature-order"
              value="1"
              class="mt-1 block w-full rounded-xl border border-border bg-bg px-3.5 py-2 text-sm text-text focus:outline-none focus:border-accent"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-text">Picha (Image URL - Hiari)</label>
          <input
            type="text"
            id="feature-image"
            placeholder="https://..."
            class="mt-1 block w-full rounded-xl border border-border bg-bg px-3.5 py-2 text-sm text-text focus:outline-none focus:border-accent"
          />
        </div>

        <div class="pt-2 flex justify-end gap-2 border-t border-border">
          <button type="button" id="cancel-feature-modal-btn" class="px-4 py-2 text-xs font-bold text-text-muted hover:text-text cursor-pointer">Ghairi</button>
          <button type="submit" id="save-feature-btn" class="rounded-xl bg-dark-green px-5 py-2 text-xs font-bold text-white hover:bg-accent transition cursor-pointer">Hifadhi</button>
        </div>
      </form>
    </div>
  </div>

  <script define:vars={{ supabaseUrl, supabaseKey }}>
    const modal = document.getElementById('feature-modal');
    const form = document.getElementById('feature-form');
    const modalTitle = document.getElementById('feature-modal-title');
    const idInput = document.getElementById('feature-id');
    const titleInput = document.getElementById('feature-title');
    const descInput = document.getElementById('feature-desc');
    const iconInput = document.getElementById('feature-icon');
    const orderInput = document.getElementById('feature-order');
    const imageInput = document.getElementById('feature-image');

    function resetForm() {
      idInput.value = '';
      titleInput.value = '';
      descInput.value = '';
      iconInput.value = '';
      orderInput.value = '1';
      imageInput.value = '';
      modalTitle.textContent = 'Ongeza Kipengele Mpya';
    }

    document.getElementById('open-feature-modal-btn')?.addEventListener('click', () => {
      resetForm();
      modal?.classList.remove('hidden');
    });

    document.getElementById('close-feature-modal-btn')?.addEventListener('click', () => modal?.classList.add('hidden'));
    document.getElementById('cancel-feature-modal-btn')?.addEventListener('click', () => modal?.classList.add('hidden'));

    // Edit
    document.querySelectorAll('.edit-feature-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const raw = btn.getAttribute('data-feature');
        if (!raw) return;
        const feat = JSON.parse(raw);
        idInput.value = feat.id;
        titleInput.value = feat.title || '';
        descInput.value = feat.description || '';
        iconInput.value = feat.icon || '';
        orderInput.value = feat.display_order ?? 1;
        imageInput.value = feat.image_url || '';
        modalTitle.textContent = 'Hariri Kipengele';
        modal?.classList.remove('hidden');
      });
    });

    // Save
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = idInput.value;
      const payload = {
        title: titleInput.value.trim(),
        description: descInput.value.trim(),
        icon: iconInput.value.trim() || null,
        display_order: parseInt(orderInput.value) || 1,
        image_url: imageInput.value.trim() || null,
      };

      try {
        const endpoint = id
          ? `${supabaseUrl}/rest/v1/features?id=eq.${id}`
          : `${supabaseUrl}/rest/v1/features`;
        const method = id ? 'PATCH' : 'POST';

        const res = await fetch(endpoint, {
          method,
          headers: {
            'Content-Type': 'application/json',
            'apikey': supabaseKey,
            'Authorization': `Bearer ${supabaseKey}`,
          },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          alert('Kipengele kimehifadhiwa!');
          window.location.reload();
        } else {
          alert('Haikuweza kuhifadhi.');
        }
      } catch (err) {
        console.error(err);
        alert('Hitilafu ya mtandao.');
      }
    });

    // Delete
    document.querySelectorAll('.delete-feature-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const title = btn.getAttribute('data-title');
        if (!confirm(`Je, una uhakika unataka kufuta kipengele "${title}"?`)) return;

        try {
          const res = await fetch(`${supabaseUrl}/rest/v1/features?id=eq.${id}`, {
            method: 'DELETE',
            headers: {
              'apikey': supabaseKey,
              'Authorization': `Bearer ${supabaseKey}`,
            },
          });
          if (res.ok) {
            document.querySelector(`div[data-id="${id}"]`)?.remove();
          } else {
            alert('Haikuweza kufuta.');
          }
        } catch (err) {
          console.error(err);
          alert('Hitilafu ya mtandao.');
        }
      });
    });
  </script>
</AdminLayout>

