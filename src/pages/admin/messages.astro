---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { supabase } from '@/utils/supabase';

const { data: rawMessages } = await supabase
  .from('contact_messages')
  .select('*')
  .order('created_at', { ascending: false });

const messages = rawMessages || [];
---

<AdminLayout title="Ujumbe wa Wasomaji" activeNav="messages">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-dark-green sm:text-3xl">
          Ujumbe wa Wasomaji (Contact Inquiries)
        </h1>
        <p class="mt-1 text-sm text-text-muted">
          Pitia maswali na maoni yaliyotumwa na wasomaji kupitia fomu ya mawasiliano.
        </p>
      </div>

      <span class="rounded-full bg-primary-soft px-3 py-1 text-xs font-bold text-dark-green border border-border">
        Jumla: {messages.length}
      </span>
    </div>

    <div class="rounded-2xl border border-border bg-white shadow-2xs overflow-hidden">
      {messages.length === 0 ? (
        <div class="p-8 text-center text-text-muted text-sm">Hakuna ujumbe uliopokelewa bado.</div>
      ) : (
        <div class="divide-y divide-border">
          {messages.map(msg => (
            <div class="p-6 hover:bg-primary-soft/10 transition">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="size-9 rounded-full bg-primary-soft text-dark-green font-bold text-xs flex items-center justify-center border border-border">
                    {msg.name ? msg.name.slice(0, 2).toUpperCase() : 'HT'}
                  </div>
                  <div>
                    <h3 class="font-bold text-text text-sm sm:text-base">{msg.name || 'Mtumaji'}</h3>
                    <div class="flex items-center gap-2 text-xs text-text-muted">
                      <span>{msg.email}</span>
                      {msg.phone && (
                        <>
                          <span>·</span>
                          <span>{msg.phone}</span>
                        </>
                      )}
                    </div>
                  </div>
                </div>

                <div class="flex items-center gap-3">
                  <span
                    class={`rounded-full px-2.5 py-0.5 text-xs font-bold ${
                      msg.status === 'resolved'
                        ? 'bg-emerald-100 text-emerald-800'
                        : 'bg-amber-100 text-amber-800'
                    }`}
                  >
                    {msg.status === 'resolved' ? 'Imetatuliwa' : 'Mpya (New)'}
                  </span>
                  <span class="text-xs text-text-muted">
                    {new Date(msg.created_at).toLocaleDateString('sw-TZ')}
                  </span>
                </div>
              </div>

              {msg.subject && (
                <div class="mt-3 text-xs font-bold text-dark-green uppercase tracking-wide">
                  Mada: {msg.subject}
                </div>
              )}

              <p class="mt-2 text-sm text-text leading-relaxed bg-bg rounded-xl p-4 border border-border/40">
                {msg.message}
              </p>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</AdminLayout>

