---
import '@styles/global.css';
import EditorTopBar from '@/components/admin/editor/EditorTopBar.astro';
import MediumEditor from '@/components/admin/editor/MediumEditor.astro';
import PublishModal from '@/components/admin/editor/PublishModal.astro';
import { getArticles, getArticleById, getCategories } from '@/utils/supabase';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map(article => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { id } = Astro.params;
const { article: propArticle } = Astro.props;
const article = propArticle || (await getArticleById(id as string));
const categories = await getCategories();
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || 'https://rgbnwbeyrjxmgmamwdgd.supabase.co';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_SERVICE_ROLE_KEY || '';
---

<!doctype html>
<html lang="sw" class="h-full bg-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hariri: {article?.title || 'Makala'} | HealthTalks</title>
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400..700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      if (!localStorage.getItem('healthtalks_admin_session')) {
        window.location.href = '/admin/login';
      }
    </script>
  </head>
  <body class="min-h-full bg-white font-sans text-text antialiased selection:bg-primary-soft selection:text-dark-green">
    <EditorTopBar isEditing={true} />
    <main class="w-full">
      <MediumEditor initialArticle={article} supabaseUrl={supabaseUrl} supabaseKey={supabaseKey} />
    </main>
    <PublishModal categories={categories} />
  </body>
</html>
