---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getCategories } from '@/utils/supabase';

const categories = await getCategories();
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || 'https://rgbnwbeyrjxmgmamwdgd.supabase.co';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_SERVICE_ROLE_KEY || '';
---

<AdminLayout title="Mada na Makundi ya Afya" activeNav="categories">
  <div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-dark-green sm:text-3xl">
          Mada na Makundi (Categories)
        </h1>
        <p class="mt-1 text-sm text-text-muted">
          Panga makala za afya kwa makundi maalum kama vile Lishe, Afya ya Akili, Mazoezi, n.k.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      {/* Create New Category Card */}
      <div class="rounded-2xl border border-border bg-white p-6 shadow-2xs h-fit">
        <h2 class="text-lg font-bold text-dark-green mb-4">Ongeza Kundi Jipya</h2>
        <form id="create-category-form" class="space-y-4">
          <div>
            <label for="cat-name" class="block text-xs font-bold text-text uppercase">Jina la Kundi *</label>
            <input
              type="text"
              id="cat-name"
              required
              placeholder="mf. Afya ya Moyo"
              class="mt-1.5 block w-full rounded-xl border border-border bg-bg px-3.5 py-2.5 text-sm text-text focus:border-accent focus:bg-white focus:outline-none"
            />
          </div>

          <div>
            <label for="cat-slug" class="block text-xs font-bold text-text uppercase">Slug *</label>
            <input
              type="text"
              id="cat-slug"
              required
              placeholder="afya-ya-moyo"
              class="mt-1.5 block w-full rounded-xl border border-border bg-bg px-3.5 py-2.5 text-sm text-text focus:border-accent focus:bg-white focus:outline-none"
            />
          </div>

          <div>
            <label for="cat-desc" class="block text-xs font-bold text-text uppercase">Maelezo (Description)</label>
            <textarea
              id="cat-desc"
              rows="3"
              placeholder="Maelezo mafupi ya kundi hili..."
              class="mt-1.5 block w-full rounded-xl border border-border bg-bg px-3.5 py-2.5 text-sm text-text focus:border-accent focus:bg-white focus:outline-none"
            ></textarea>
          </div>

          <div>
            <label for="cat-color" class="block text-xs font-bold text-text uppercase">Rangi ya Utambulisho</label>
            <div class="mt-1.5 flex items-center gap-3">
              <input
                type="color"
                id="cat-color"
                value="#2E7D1F"
                class="size-10 cursor-pointer rounded-lg border border-border bg-bg p-1"
              />
              <span class="text-xs text-text-muted font-mono" id="cat-color-label">#2E7D1F</span>
            </div>
          </div>

          <button
            type="submit"
            id="cat-submit-btn"
            class="w-full rounded-xl bg-dark-green py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-accent"
          >
            Hifadhi Kundi (Add Category)
          </button>
        </form>
      </div>

      {/* Categories List */}
      <div class="lg:col-span-2 rounded-2xl border border-border bg-white shadow-2xs overflow-hidden">
        <div class="p-4 border-b border-border bg-bg flex items-center justify-between">
          <span class="text-xs font-bold text-text-muted uppercase tracking-wider">
            Makundi Yaliyopo ({categories.length})
          </span>
        </div>

        <div class="divide-y divide-border">
          {categories.map(cat => (
            <div class="p-5 flex items-start justify-between gap-4 hover:bg-primary-soft/10 transition" data-id={cat.id}>
              <div class="flex items-start gap-3.5">
                <span
                  class="size-10 rounded-xl flex items-center justify-center font-extrabold text-sm text-white shrink-0 shadow-2xs"
                  style={`background-color: ${cat.color || '#2E7D1F'};`}
                >
                  {cat.name.slice(0, 2).toUpperCase()}
                </span>
                <div>
                  <h3 class="font-bold text-text text-base flex items-center gap-2">
                    {cat.name}
                    <span class="text-xs font-mono font-normal text-text-muted">/{cat.slug}</span>
                  </h3>
                  <p class="text-xs text-text-muted mt-1 leading-relaxed">{cat.description || 'Hakuna maelezo.'}</p>
                </div>
              </div>

              <button
                type="button"
                class="delete-cat-btn rounded-lg border border-red-200 px-2.5 py-1 text-xs font-bold text-red-600 hover:bg-red-50 transition shrink-0"
                data-id={cat.id}
                data-name={cat.name}
              >
                Futa
              </button>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ supabaseUrl, supabaseKey }}>
    const nameInput = document.getElementById('cat-name');
    const slugInput = document.getElementById('cat-slug');
    const colorInput = document.getElementById('cat-color');
    const colorLabel = document.getElementById('cat-color-label');

    nameInput?.addEventListener('input', (e) => {
      slugInput.value = e.target.value
        .toLowerCase()
        .trim()
        .replace(/[^\w\s-]/g, '')
        .replace(/[\s_-]+/g, '-')
        .replace(/^-+|-+$/g, '');
    });

    colorInput?.addEventListener('input', (e) => {
      colorLabel.textContent = e.target.value.toUpperCase();
    });

    // Create Category
    const form = document.getElementById('create-category-form');
    const submitBtn = document.getElementById('cat-submit-btn');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Inahifadhi...';

      const payload = {
        name: nameInput.value,
        slug: slugInput.value,
        description: document.getElementById('cat-desc').value,
        color: colorInput.value,
      };

      try {
        const res = await fetch(`${supabaseUrl}/rest/v1/categories`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'apikey': supabaseKey,
            'Authorization': `Bearer ${supabaseKey}`,
            'Prefer': 'return=representation'
          },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          alert('Kundi limeongezwa vizuri!');
          window.location.reload();
        } else {
          const err = await res.json();
          alert('Hitilafu: ' + (err.message || 'Haikuweza kuongeza kundi.'));
          submitBtn.disabled = false;
          submitBtn.textContent = 'Hifadhi Kundi (Add Category)';
        }
      } catch (err) {
        alert('Hitilafu ya mtandao.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Hifadhi Kundi (Add Category)';
      }
    });

    // Delete Category
    document.querySelectorAll('.delete-cat-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name');
        if (!confirm(`Una uhakika unataka kufuta kundi hili: "${name}"?`)) return;

        btn.disabled = true;
        try {
          const res = await fetch(`${supabaseUrl}/rest/v1/categories?id=eq.${id}`, {
            method: 'DELETE',
            headers: {
              'apikey': supabaseKey,
              'Authorization': `Bearer ${supabaseKey}`
            }
          });

          if (res.ok) {
            window.location.reload();
          } else {
            alert('Haiwezekani kufuta kundi lenye makala zilizofungamana nalo.');
            btn.disabled = false;
          }
        } catch (err) {
          alert('Hitilafu ya mtandao.');
          btn.disabled = false;
        }
      });
    });
  </script>
</AdminLayout>
