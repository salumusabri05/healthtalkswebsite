---
import AdminLayout from '@/layouts/AdminLayout.astro';
import {
  getArticles,
  getCategories,
  getAnnouncements,
  getContactMessages,
  getNewsletterSubscribers,
  getFeatures,
  getCarouselImages,
  getFeaturedVideos,
  getTags,
} from '@/utils/supabase';

// Fetch live counts across all tables from Supabase
const [
  articles,
  categories,
  announcements,
  messages,
  subscribers,
  features,
  carouselImages,
  videos,
  tags,
] = await Promise.all([
  getArticles(),
  getCategories(),
  getAnnouncements(),
  getContactMessages(),
  getNewsletterSubscribers(),
  getFeatures(),
  getCarouselImages(),
  getFeaturedVideos(),
  getTags(),
]);

const publishedCount = articles.filter(a => a.status === 'published').length;
const draftCount = articles.filter(a => a.status === 'draft').length;
const recentArticles = articles.slice(0, 5);
---

<AdminLayout title="Dashibodi ya CMS" activeNav="dashboard">
  <div class="space-y-8">
    {/* Page Header */}
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-dark-green sm:text-3xl">
          Dashibodi ya Usimamizi (CMS Dashboard)
        </h1>
        <p class="mt-1 text-sm text-text-muted">
          Simamia maudhui ya HealthTalks, makala, video, mada, na matangazo moja kwa moja kupitia Supabase.
        </p>
      </div>

      <div class="flex items-center gap-2.5">
        <a
          href="/admin/articles/new"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-dark-green px-4 py-2.5 text-xs font-bold text-white shadow-sm transition hover:bg-accent"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
          </svg>
          Andika Makala Mpya
        </a>
      </div>
    </div>

    {/* Metric Stat Cards (9 Tables Overview) */}
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {/* Articles */}
      <a href="/admin/articles" class="rounded-2xl border border-border bg-white p-5 shadow-2xs hover:border-accent/40 transition">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-text-muted">Makala (Articles)</span>
          <span class="rounded-lg bg-primary-soft p-2 text-dark-green">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z" />
            </svg>
          </span>
        </div>
        <div class="mt-3 flex items-baseline gap-2">
          <span class="text-3xl font-extrabold text-dark-green">{articles.length}</span>
          <span class="text-xs text-emerald-600 font-semibold">{publishedCount} live</span>
        </div>
      </a>

      {/* Categories */}
      <a href="/admin/categories" class="rounded-2xl border border-border bg-white p-5 shadow-2xs hover:border-accent/40 transition">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-text-muted">Makundi (Categories)</span>
          <span class="rounded-lg bg-primary-soft p-2 text-dark-green">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
            </svg>
          </span>
        </div>
        <div class="mt-3">
          <span class="text-3xl font-extrabold text-dark-green">{categories.length}</span>
        </div>
      </a>

      {/* Subscribers */}
      <a href="/admin/subscribers" class="rounded-2xl border border-border bg-white p-5 shadow-2xs hover:border-accent/40 transition">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-text-muted">Jarida (Subscribers)</span>
          <span class="rounded-lg bg-emerald-50 p-2 text-emerald-700">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="20" height="16" x="2" y="4" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
          </span>
        </div>
        <div class="mt-3">
          <span class="text-3xl font-extrabold text-emerald-700">{subscribers.length}</span>
        </div>
      </a>

      {/* Messages */}
      <a href="/admin/messages" class="rounded-2xl border border-border bg-white p-5 shadow-2xs hover:border-accent/40 transition">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-text-muted">Ujumbe (Messages)</span>
          <span class="rounded-lg bg-primary-soft p-2 text-dark-green">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
          </span>
        </div>
        <div class="mt-3">
          <span class="text-3xl font-extrabold text-dark-green">{messages.length}</span>
        </div>
      </a>

      {/* Announcements */}
      <a href="/admin/announcements" class="rounded-2xl border border-border bg-white p-5 shadow-2xs hover:border-accent/40 transition">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-text-muted">Matangazo</span>
          <span class="rounded-lg bg-amber-50 p-2 text-amber-700">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m3 11 18-5v12L3 14v-3z" />
            </svg>
          </span>
        </div>
        <div class="mt-3">
          <span class="text-3xl font-extrabold text-amber-700">{announcements.length}</span>
        </div>
      </a>

      {/* Features */}
      <a href="/admin/features" class="rounded-2xl border border-border bg-white p-5 shadow-2xs hover:border-accent/40 transition">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-text-muted">Vipengele (Features)</span>
          <span class="rounded-lg bg-primary-soft p-2 text-dark-green">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </span>
        </div>
        <div class="mt-3">
          <span class="text-3xl font-extrabold text-dark-green">{features.length}</span>
        </div>
      </a>

      {/* Carousel */}
      <a href="/admin/carousel" class="rounded-2xl border border-border bg-white p-5 shadow-2xs hover:border-accent/40 transition">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-text-muted">Slaidi (Carousel)</span>
          <span class="rounded-lg bg-primary-soft p-2 text-dark-green">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="18" height="18" x="3" y="3" rx="2" />
              <circle cx="9" cy="9" r="2" />
            </svg>
          </span>
        </div>
        <div class="mt-3">
          <span class="text-3xl font-extrabold text-dark-green">{carouselImages.length}</span>
        </div>
      </a>

      {/* Videos */}
      <a href="/admin/videos" class="rounded-2xl border border-border bg-white p-5 shadow-2xs hover:border-accent/40 transition">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-text-muted">Video (Programs)</span>
          <span class="rounded-lg bg-red-50 p-2 text-red-600">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="23 7 16 12 23 17 23 7" />
              <rect width="15" height="14" x="1" y="5" rx="2" />
            </svg>
          </span>
        </div>
        <div class="mt-3">
          <span class="text-3xl font-extrabold text-red-600">{videos.length}</span>
        </div>
      </a>

      {/* Tags */}
      <a href="/admin/tags" class="rounded-2xl border border-border bg-white p-5 shadow-2xs hover:border-accent/40 transition">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-text-muted">Lebo (Tags)</span>
          <span class="rounded-lg bg-primary-soft p-2 text-dark-green">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z" />
              <circle cx="7" cy="7" r=".5" fill="currentColor" />
            </svg>
          </span>
        </div>
        <div class="mt-3 flex items-baseline gap-2">
          <span class="text-3xl font-extrabold text-dark-green">{tags.length}</span>
          <span class="text-xs text-text-muted">({draftCount} rasimu)</span>
        </div>
      </a>
    </div>

    {/* Recent Articles Table */}
    <div class="rounded-2xl border border-border bg-white shadow-2xs overflow-hidden">
      <div class="flex items-center justify-between border-b border-border bg-bg p-4 sm:px-6">
        <div>
          <h2 class="text-base font-extrabold text-dark-green">Makala za Hivi Karibuni</h2>
          <p class="text-xs text-text-muted">Makala 5 zilizoongezwa au kusasishwa hivi punde</p>
        </div>
        <a
          href="/admin/articles"
          class="rounded-lg border border-border bg-white px-3 py-1.5 text-xs font-bold text-dark-green hover:bg-primary-soft transition"
        >
          Tazama Zote ({articles.length}) →
        </a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-start text-sm">
          <thead class="bg-white text-xs font-bold uppercase tracking-wider text-text-muted border-b border-border">
            <tr>
              <th class="px-6 py-3.5 text-start">Kichwa cha Makala</th>
              <th class="px-6 py-3.5 text-start">Kundi</th>
              <th class="px-6 py-3.5 text-start">Hali</th>
              <th class="px-6 py-3.5 text-start">Tarehe</th>
              <th class="px-6 py-3.5 text-end">Kitendo</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {recentArticles.map(article => (
              <tr class="hover:bg-primary-soft/20 transition">
                <td class="px-6 py-4 font-bold text-dark-green">
                  <div class="flex items-center gap-3">
                    {article.featured_image ? (
                      <img
                        src={article.featured_image}
                        alt={article.title}
                        class="size-10 rounded-lg object-cover border border-border shrink-0"
                      />
                    ) : (
                      <div class="size-10 rounded-lg bg-primary-soft text-dark-green flex items-center justify-center font-bold text-xs shrink-0">
                        HT
                      </div>
                    )}
                    <span class="line-clamp-1">{article.title}</span>
                  </div>
                </td>
                <td class="px-6 py-4 text-xs font-semibold text-text-muted">
                  <span class="rounded-md bg-primary-soft px-2 py-0.5 text-dark-green border border-border/60">
                    {article.categories?.name || 'Afya'}
                  </span>
                </td>
                <td class="px-6 py-4">
                  <span
                    class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-bold ${
                      article.status === 'published'
                        ? 'bg-emerald-100 text-emerald-800'
                        : 'bg-amber-100 text-amber-800'
                    }`}
                  >
                    <span class={`size-1.5 rounded-full ${article.status === 'published' ? 'bg-emerald-600' : 'bg-amber-600'}`}></span>
                    {article.status === 'published' ? 'Live' : 'Rasimu'}
                  </span>
                </td>
                <td class="px-6 py-4 text-xs text-text-muted">
                  {new Date(article.created_at).toLocaleDateString('sw-TZ')}
                </td>
                <td class="px-6 py-4 text-end">
                  <a
                    href={`/admin/articles/${article.id}`}
                    class="rounded-lg border border-border bg-white px-2.5 py-1 text-xs font-bold text-dark-green hover:bg-primary-soft transition"
                  >
                    Hariri
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
