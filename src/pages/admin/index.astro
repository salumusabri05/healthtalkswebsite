---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getArticles, getCategories, getAnnouncements, getContactMessages } from '@/utils/supabase';

// Fetch live counts from Supabase
const [articles, categories, announcements, messages] = await Promise.all([
  getArticles(),
  getCategories(),
  getAnnouncements(),
  getContactMessages(),
]);

const publishedCount = articles.filter(a => a.status === 'published').length;
const draftCount = articles.filter(a => a.status === 'draft').length;
const recentArticles = articles.slice(0, 5);
---

<AdminLayout title="Dashibodi ya CMS" activeNav="dashboard">
  <div class="space-y-6">
    {/* Page Header */}
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-dark-green sm:text-3xl">
          Dashibodi ya Usimamizi (CMS Dashboard)
        </h1>
        <p class="mt-1 text-sm text-text-muted">
          Simamia maudhui ya HealthTalks, makala za afya, mada, na matangazo moja kwa moja kupitia Supabase.
        </p>
      </div>

      <a
        href="/admin/articles/new"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-dark-green px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-accent"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="12" y1="5" x2="12" y2="19" />
          <line x1="5" y1="12" x2="19" y2="12" />
        </svg>
        Andika Makala Mpya
      </a>
    </div>

    {/* Metric Stat Cards */}
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {/* Total Articles */}
      <div class="rounded-2xl border border-border bg-white p-5 shadow-2xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-text-muted">Jumla ya Makala</span>
          <span class="rounded-lg bg-primary-soft p-2 text-dark-green">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z" />
            </svg>
          </span>
        </div>
        <div class="mt-3 flex items-baseline gap-2">
          <span class="text-3xl font-extrabold text-dark-green">{articles.length}</span>
          <span class="text-xs text-text-muted">zilizopo</span>
        </div>
      </div>

      {/* Published Articles */}
      <div class="rounded-2xl border border-border bg-white p-5 shadow-2xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-text-muted">Zilizochapishwa</span>
          <span class="rounded-lg bg-emerald-50 p-2 text-emerald-700">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
          </span>
        </div>
        <div class="mt-3 flex items-baseline gap-2">
          <span class="text-3xl font-extrabold text-emerald-700">{publishedCount}</span>
          <span class="text-xs text-emerald-600 font-semibold">Live kwenye wavuti</span>
        </div>
      </div>

      {/* Draft Articles */}
      <div class="rounded-2xl border border-border bg-white p-5 shadow-2xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-text-muted">Rasimu (Drafts)</span>
          <span class="rounded-lg bg-amber-50 p-2 text-amber-700">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 20h9" />
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
            </svg>
          </span>
        </div>
        <div class="mt-3 flex items-baseline gap-2">
          <span class="text-3xl font-extrabold text-amber-700">{draftCount}</span>
          <span class="text-xs text-amber-600 font-semibold">Zinasubiri</span>
        </div>
      </div>

      {/* Categories */}
      <div class="rounded-2xl border border-border bg-white p-5 shadow-2xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-text-muted">Mada za Afya</span>
          <span class="rounded-lg bg-primary-soft p-2 text-dark-green">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
            </svg>
          </span>
        </div>
        <div class="mt-3 flex items-baseline gap-2">
          <span class="text-3xl font-extrabold text-dark-green">{categories.length}</span>
          <span class="text-xs text-text-muted">makundi</span>
        </div>
      </div>
    </div>

    {/* Recent Articles Table */}
    <div class="rounded-2xl border border-border bg-white shadow-2xs overflow-hidden">
      <div class="flex items-center justify-between border-b border-border px-6 py-4">
        <div>
          <h2 class="text-lg font-bold text-dark-green">Makala za Hivi Karibuni</h2>
          <p class="text-xs text-text-muted">Makala 5 zilizoongezwa hivi karibuni kwenye Supabase</p>
        </div>
        <a
          href="/admin/articles"
          class="text-xs font-bold text-accent hover:text-dark-green transition flex items-center gap-1"
        >
          Tazama Zote
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-start text-sm">
          <thead class="bg-bg text-xs font-bold uppercase tracking-wider text-text-muted border-b border-border">
            <tr>
              <th class="px-6 py-3 text-start">Kichwa cha Habari (Title)</th>
              <th class="px-6 py-3 text-start">Kundi (Category)</th>
              <th class="px-6 py-3 text-start">Mwandishi</th>
              <th class="px-6 py-3 text-start">Hali (Status)</th>
              <th class="px-6 py-3 text-end">Kitendo</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {recentArticles.map(article => (
              <tr class="hover:bg-primary-soft/20 transition">
                <td class="px-6 py-4 font-bold text-text">
                  <div class="flex items-center gap-2">
                    {article.is_featured && (
                      <span class="rounded bg-accent/20 px-1.5 py-0.5 text-[10px] font-bold text-dark-green">
                        Featured
                      </span>
                    )}
                    <span class="line-clamp-1">{article.title || '(Bila Jina)'}</span>
                  </div>
                  <span class="text-xs text-text-muted font-normal">/{article.slug}</span>
                </td>
                <td class="px-6 py-4 text-xs font-semibold text-text-muted">
                  <span class="rounded-md bg-primary-soft px-2.5 py-1 text-dark-green border border-border/60">
                    {article.categories?.name || 'Afya'}
                  </span>
                </td>
                <td class="px-6 py-4 text-xs font-medium text-text-muted">
                  {article.author_name || 'Admin'}
                </td>
                <td class="px-6 py-4">
                  <span
                    class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-bold ${
                      article.status === 'published'
                        ? 'bg-emerald-100 text-emerald-800'
                        : 'bg-amber-100 text-amber-800'
                    }`}
                  >
                    <span class={`size-1.5 rounded-full ${article.status === 'published' ? 'bg-emerald-600' : 'bg-amber-600'}`}></span>
                    {article.status === 'published' ? 'Imechapishwa' : 'Rasimu'}
                  </span>
                </td>
                <td class="px-6 py-4 text-end">
                  <a
                    href={`/admin/articles/${article.id}`}
                    class="rounded-lg px-2.5 py-1 text-xs font-bold text-dark-green hover:bg-primary-soft transition inline-block"
                  >
                    Hariri (Edit)
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

