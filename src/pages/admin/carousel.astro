---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getCarouselImages } from '@/utils/supabase';

const carouselImages = await getCarouselImages();
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || 'https://rgbnwbeyrjxmgmamwdgd.supabase.co';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_SERVICE_ROLE_KEY || '';
---

<AdminLayout title="Picha za Slaidi (Carousel Images)" activeNav="carousel">
  <div class="space-y-6">
    {/* Page Header */}
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-dark-green sm:text-3xl">
          Picha za Slaidi (Hero Carousel Images)
        </h1>
        <p class="mt-1 text-sm text-text-muted">
          Simamia mabango na slaidi za picha zinazozunguka juu kwenye ukurasa wa mwanzo.
        </p>
      </div>

      <button
        type="button"
        id="open-carousel-modal-btn"
        class="inline-flex items-center gap-2 rounded-xl bg-dark-green px-4 py-2.5 text-xs font-bold text-white shadow-sm transition hover:bg-accent cursor-pointer"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="12" y1="5" x2="12" y2="19" />
          <line x1="5" y1="12" x2="19" y2="12" />
        </svg>
        Weka Picha Mpya ya Slaidi
      </button>
    </div>

    {/* Carousel Items Grid */}
    {carouselImages.length === 0 ? (
      <div class="rounded-3xl border border-dashed border-border bg-white p-12 text-center">
        <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-primary-soft text-dark-green">
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="18" height="18" x="3" y="3" rx="2" />
            <circle cx="9" cy="9" r="2" />
            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
          </svg>
        </div>
        <h3 class="mt-4 text-base font-extrabold text-dark-green">Hakuna Slaidi Zilizowekwa Bado</h3>
        <p class="mt-1 text-xs text-text-muted max-w-sm mx-auto">
          Ongeza picha za mabango yenye ujumbe wa hamasa ya kiafya ili yajioneshe kwenye ukurasa wa mwanzo.
        </p>
        <button
          type="button"
          onclick="document.getElementById('open-carousel-modal-btn')?.click()"
          class="mt-4 inline-flex items-center gap-2 rounded-xl bg-dark-green px-4 py-2 text-xs font-bold text-white hover:bg-accent transition cursor-pointer"
        >
          Weka Slaidi ya Kwanza
        </button>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {carouselImages.map(slide => (
          <div class="rounded-2xl border border-border bg-white overflow-hidden shadow-2xs flex flex-col justify-between" data-id={slide.id}>
            <div>
              <div class="relative aspect-[16/9] w-full bg-primary-soft/30 overflow-hidden">
                <img src={slide.image_url} alt={slide.image_alt || slide.title} class="size-full object-cover" />
                <span class={`absolute top-3 left-3 rounded-full px-2.5 py-0.5 text-[10px] font-bold ${slide.status === 'active' ? 'bg-emerald-500 text-white' : 'bg-neutral-800/80 text-white'}`}>
                  {slide.status === 'active' ? 'Inaonekana' : 'Imefichwa'}
                </span>
                <span class="absolute top-3 right-3 rounded-full bg-white/90 px-2 py-0.5 text-[10px] font-bold text-dark-green border border-border">
                  #{slide.display_order ?? 1}
                </span>
              </div>

              <div class="p-5">
                <h3 class="text-base font-extrabold text-dark-green line-clamp-1">{slide.title}</h3>
                {slide.description && (
                  <p class="mt-1 text-xs text-text-muted line-clamp-2">{slide.description}</p>
                )}
                {slide.link_url && (
                  <div class="mt-3 text-[11px] text-accent font-semibold truncate">
                    🔗 {slide.link_url}
                  </div>
                )}
              </div>
            </div>

            <div class="p-4 border-t border-border/60 flex items-center justify-between bg-bg/50">
              <span class="text-[11px] text-text-muted">Mibofyo: {slide.click_count || 0}</span>
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  class="edit-slide-btn rounded-lg border border-border bg-white px-2.5 py-1 text-xs font-bold text-dark-green hover:bg-primary-soft transition cursor-pointer"
                  data-slide={JSON.stringify(slide)}
                >
                  Hariri
                </button>
                <button
                  type="button"
                  class="delete-slide-btn rounded-lg border border-red-200 bg-white px-2.5 py-1 text-xs font-bold text-red-600 hover:bg-red-50 transition cursor-pointer"
                  data-id={slide.id}
                  data-title={slide.title}
                >
                  Futa
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>

  {/* Slide Modal */}
  <div id="carousel-modal" class="fixed inset-0 z-50 hidden bg-text/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="relative w-full max-w-lg rounded-3xl bg-white p-6 shadow-2xl border border-border max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-border pb-3">
        <h2 id="carousel-modal-title" class="text-base font-extrabold text-dark-green">Weka Slaidi Mpya</h2>
        <button type="button" id="close-carousel-modal-btn" class="size-7 rounded-full border border-border text-text-muted flex items-center justify-center cursor-pointer">✕</button>
      </div>

      <form id="carousel-form" class="mt-4 space-y-4">
        <input type="hidden" id="slide-id" value="" />

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-text">Kichwa cha Bango (Title) *</label>
          <input
            type="text"
            id="slide-title"
            required
            placeholder="mf. Afya ya Jamii: Pima Mapema, Ishi kwa Matumaini"
            class="mt-1 block w-full rounded-xl border border-border bg-bg px-3.5 py-2 text-sm text-text focus:outline-none focus:border-accent"
          />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-text">Maelezo Mafupi (Description)</label>
          <textarea
            id="slide-desc"
            rows="2"
            placeholder="Maelezo yatakayoonekana juu ya picha..."
            class="mt-1 block w-full rounded-xl border border-border bg-bg px-3.5 py-2 text-sm text-text focus:outline-none focus:border-accent"
          ></textarea>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-text">Picha Kuu (Image URL) *</label>
          <input
            type="text"
            id="slide-image"
            required
            placeholder="https://images.unsplash.com/... au URL ya Supabase Storage"
            class="mt-1 block w-full rounded-xl border border-border bg-bg px-3.5 py-2 text-sm text-text focus:outline-none focus:border-accent"
          />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-text">Kiungo cha Kitufe (Link URL)</label>
            <input
              type="text"
              id="slide-link"
              placeholder="/blog au https://..."
              class="mt-1 block w-full rounded-xl border border-border bg-bg px-3.5 py-2 text-sm text-text focus:outline-none focus:border-accent"
            />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-text">Nafasi (Display Order)</label>
            <input
              type="number"
              id="slide-order"
              value="1"
              class="mt-1 block w-full rounded-xl border border-border bg-bg px-3.5 py-2 text-sm text-text focus:outline-none focus:border-accent"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-text">Hali ya Kuonekana (Status)</label>
          <select
            id="slide-status"
            class="mt-1 block w-full rounded-xl border border-border bg-bg px-3.5 py-2 text-sm text-text focus:outline-none focus:border-accent"
          >
            <option value="active">Active (Inaonekana Mara Moja)</option>
            <option value="inactive">Inactive (Imefichwa)</option>
          </select>
        </div>

        <div class="pt-2 flex justify-end gap-2 border-t border-border">
          <button type="button" id="cancel-carousel-modal-btn" class="px-4 py-2 text-xs font-bold text-text-muted hover:text-text cursor-pointer">Ghairi</button>
          <button type="submit" id="save-slide-btn" class="rounded-xl bg-dark-green px-5 py-2 text-xs font-bold text-white hover:bg-accent transition cursor-pointer">Hifadhi Slaidi</button>
        </div>
      </form>
    </div>
  </div>

  <script define:vars={{ supabaseUrl, supabaseKey }}>
    const modal = document.getElementById('carousel-modal');
    const form = document.getElementById('carousel-form');
    const modalTitle = document.getElementById('carousel-modal-title');
    const idInput = document.getElementById('slide-id');
    const titleInput = document.getElementById('slide-title');
    const descInput = document.getElementById('slide-desc');
    const imageInput = document.getElementById('slide-image');
    const linkInput = document.getElementById('slide-link');
    const orderInput = document.getElementById('slide-order');
    const statusInput = document.getElementById('slide-status');

    function resetForm() {
      idInput.value = '';
      titleInput.value = '';
      descInput.value = '';
      imageInput.value = '';
      linkInput.value = '';
      orderInput.value = '1';
      statusInput.value = 'active';
      modalTitle.textContent = 'Weka Slaidi Mpya';
    }

    document.getElementById('open-carousel-modal-btn')?.addEventListener('click', () => {
      resetForm();
      modal?.classList.remove('hidden');
    });

    document.getElementById('close-carousel-modal-btn')?.addEventListener('click', () => modal?.classList.add('hidden'));
    document.getElementById('cancel-carousel-modal-btn')?.addEventListener('click', () => modal?.classList.add('hidden'));

    // Edit
    document.querySelectorAll('.edit-slide-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const raw = btn.getAttribute('data-slide');
        if (!raw) return;
        const slide = JSON.parse(raw);
        idInput.value = slide.id;
        titleInput.value = slide.title || '';
        descInput.value = slide.description || '';
        imageInput.value = slide.image_url || '';
        linkInput.value = slide.link_url || '';
        orderInput.value = slide.display_order ?? 1;
        statusInput.value = slide.status || 'active';
        modalTitle.textContent = 'Hariri Slaidi';
        modal?.classList.remove('hidden');
      });
    });

    // Save
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = idInput.value;
      const payload = {
        title: titleInput.value.trim(),
        description: descInput.value.trim() || null,
        image_url: imageInput.value.trim(),
        image_alt: titleInput.value.trim(),
        link_url: linkInput.value.trim() || null,
        display_order: parseInt(orderInput.value) || 1,
        status: statusInput.value,
        updated_at: new Date().toISOString(),
      };

      try {
        const endpoint = id
          ? `${supabaseUrl}/rest/v1/carousel_images?id=eq.${id}`
          : `${supabaseUrl}/rest/v1/carousel_images`;
        const method = id ? 'PATCH' : 'POST';

        const res = await fetch(endpoint, {
          method,
          headers: {
            'Content-Type': 'application/json',
            'apikey': supabaseKey,
            'Authorization': `Bearer ${supabaseKey}`,
          },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          alert('Slaidi imehifadhiwa!');
          window.location.reload();
        } else {
          alert('Haikuweza kuhifadhi.');
        }
      } catch (err) {
        console.error(err);
        alert('Hitilafu ya mtandao.');
      }
    });

    // Delete
    document.querySelectorAll('.delete-slide-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const title = btn.getAttribute('data-title');
        if (!confirm(`Je, una uhakika unataka kufuta slaidi "${title}"?`)) return;

        try {
          const res = await fetch(`${supabaseUrl}/rest/v1/carousel_images?id=eq.${id}`, {
            method: 'DELETE',
            headers: {
              'apikey': supabaseKey,
              'Authorization': `Bearer ${supabaseKey}`,
            },
          });
          if (res.ok) {
            document.querySelector(`div[data-id="${id}"]`)?.remove();
          } else {
            alert('Haikuweza kufuta.');
          }
        } catch (err) {
          console.error(err);
          alert('Hitilafu ya mtandao.');
        }
      });
    });
  </script>
</AdminLayout>

