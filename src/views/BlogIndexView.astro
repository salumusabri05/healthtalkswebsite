---
import MainLayout from '@/layouts/MainLayout.astro';
import CardArticle from '@components/ui/cards/CardArticle.astro';
import CardBlog from '@components/ui/cards/CardBlog.astro';
import CardInsight from '@components/ui/cards/CardInsight.astro';
import { entriesFor } from '@utils/content';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';
import { localePath } from '@utils/locale';
import { getPublishedArticles } from '@/utils/supabase';

/** The blog index (posts + insights) in one locale. */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).blogIndex;

// Fetch real articles from Supabase database
const dbArticles = await getPublishedArticles();

// Fallback markdown posts
const blogPosts = await entriesFor('blog', locale);
const insightPosts = await entriesFor('insights', locale);

// Separate featured article if available
const [featuredArticle, ...otherArticles] = dbArticles;
---

<MainLayout
  title={locale === 'sw' ? 'Makala na Blog ya Afya' : copy.title}
  description={locale === 'sw' ? 'Gundua makala za kitaalamu za afya, lishe bora, uzazi, na mtindo wa maisha zilizothibitishwa kisayansi.' : copy.metaDescription}
  ogTitle={locale === 'sw' ? 'Makala na Ushauri wa Afya | HealthTalks' : copy.ogTitle}
>
  <section class="mx-auto max-w-[85rem] space-y-6 px-4 pt-12 sm:px-6 lg:px-8 2xl:max-w-full">
    {/* Page header */}
    <div class="mx-auto max-w-3xl text-left sm:text-center">
      <div class="inline-flex items-center gap-1.5 rounded-full border border-border bg-primary-soft px-3 py-1 text-xs font-bold text-dark-green mb-3">
        <span class="size-1.5 rounded-full bg-accent"></span>
        {locale === 'sw' ? 'Makala Zilizothibitishwa Kisayansi' : 'Evidence-Based Health Articles'}
      </div>
      <h1 class="block text-3xl font-extrabold tracking-tight text-dark-green sm:text-5xl lg:text-6xl">
        {locale === 'sw' ? 'Makala & Blog ya Afya' : copy.heading}
      </h1>

      <p class="mt-4 text-base sm:text-lg text-text-muted leading-relaxed">
        {locale === 'sw'
          ? 'Pata mwongozo sahihi wa kiafya kutoka kwa madaktari na wataalamu wetu kuhusu lishe, kinga ya magonjwa, na uzima.'
          : copy.subTitle}
      </p>
    </div>
  </section>

  {/* Real Articles from Database Section */}
  {dbArticles.length > 0 ? (
    <section class="mx-auto max-w-[85rem] px-4 py-8 sm:px-6 lg:px-8 2xl:max-w-full space-y-10">
      {/* Featured Headline Article */}
      {featuredArticle && (
        <div class="overflow-hidden rounded-3xl border border-border bg-white shadow-sm transition-all duration-300 hover:border-accent/40 hover:shadow-md">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 items-center">
            <div class="lg:col-span-7 aspect-[16/10] sm:aspect-[16/9] w-full overflow-hidden bg-primary-soft/40 relative">
              {featuredArticle.featured_image ? (
                <img
                  src={featuredArticle.featured_image}
                  alt={featuredArticle.title}
                  class="size-full object-cover transition duration-500 hover:scale-103"
                  loading="eager"
                />
              ) : (
                <div class="flex size-full items-center justify-center text-3xl font-bold text-dark-green bg-primary-soft">
                  HealthTalks
                </div>
              )}
              <span class="absolute top-4 left-4 rounded-full bg-white/95 backdrop-blur-xs px-3.5 py-1 text-xs font-bold text-dark-green shadow-xs border border-border">
                {featuredArticle.categories?.name || 'Kipengele Maalum'}
              </span>
            </div>

            <div class="lg:col-span-5 p-6 sm:p-10 flex flex-col justify-center">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold uppercase tracking-wider text-accent">
                  {featuredArticle.categories?.name || 'Afya'}
                </span>
                {featuredArticle.medically_reviewed && (
                  <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-800">
                    ✓ Medically Reviewed
                  </span>
                )}
              </div>

              <h2 class="mt-2 text-2xl sm:text-3xl font-extrabold tracking-tight text-dark-green hover:text-accent transition">
                <a href={localePath(locale, `/blog/${featuredArticle.slug || featuredArticle.id}`)}>
                  {featuredArticle.title}
                </a>
              </h2>

              <p class="mt-3 text-sm sm:text-base text-text-muted leading-relaxed line-clamp-3">
                {featuredArticle.excerpt || 'Soma uchambuzi wa kina na ushauri wa kitaalamu kutoka kwa jopo letu la wataalamu wa afya...'}
              </p>

              <div class="mt-6 flex items-center justify-between border-t border-border/60 pt-4 text-xs font-semibold text-text-muted">
                <div class="flex items-center gap-2">
                  <div class="size-7 rounded-full bg-primary-soft text-dark-green flex items-center justify-center font-bold text-xs border border-border">
                    {featuredArticle.author_name ? featuredArticle.author_name.slice(0, 2).toUpperCase() : 'HT'}
                  </div>
                  <span class="font-bold text-text">{featuredArticle.author_name || 'HealthTalks Team'}</span>
                </div>

                <a
                  href={localePath(locale, `/blog/${featuredArticle.slug || featuredArticle.id}`)}
                  class="rounded-full bg-dark-green px-4 py-2 text-xs font-bold text-white transition hover:bg-accent"
                >
                  {locale === 'sw' ? 'Soma Makala →' : 'Read Article →'}
                </a>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Grid of Other Database Articles */}
      {otherArticles.length > 0 && (
        <div>
          <div class="flex items-center justify-between mb-6 pb-2 border-b border-border">
            <h2 class="text-xl font-extrabold text-dark-green">
              {locale === 'sw' ? 'Makala Zingine za Hivi Karibuni' : 'Recent Articles'}
            </h2>
            <span class="text-xs font-semibold text-text-muted">
              {otherArticles.length} {locale === 'sw' ? 'Makala' : 'Articles'}
            </span>
          </div>

          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {otherArticles.map(article => (
              <CardArticle article={article} locale={locale} />
            ))}
          </div>
        </div>
      )}
    </section>
  ) : (
    /* Fallback markdown posts if database has no published articles yet */
    <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
      {blogPosts.length === 0 ? (
        <p class="text-center text-text-muted">
          {copy.noPosts}
        </p>
      ) : (
        <div class="grid gap-6 lg:grid-cols-2">
          {blogPosts.map(blogEntry => (
            <CardBlog blogEntry={blogEntry} />
          ))}
        </div>
      )}
    </section>
  )}

  {/* Insights section */}
  {insightPosts.length > 0 && (
    <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full border-t border-border/60">
      <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <h2 class="text-2xl font-extrabold text-dark-green md:text-4xl md:leading-tight">
          {copy.insightsHeading}
        </h2>
        <p class="mt-2 text-base text-text-muted">
          {copy.insightsSubTitle}
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {insightPosts.map(insightEntry => (
          <CardInsight insightEntry={insightEntry} />
        ))}
      </div>
    </section>
  )}
</MainLayout>
