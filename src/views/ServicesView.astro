---
import MainLayout from '@/layouts/MainLayout.astro';
import MainSection from '@components/ui/blocks/MainSection.astro';
import AlternatingSections, {
  type Article,
} from '@components/ui/blocks/AlternatingSections.astro';
import FeaturesStats from '@components/sections/features/FeaturesStats.astro';
import doctor from '@images/health/doctor.jpeg';
import groupSession from '@images/health/groupsession.jpeg';
import healthyMeal from '@images/health/healthymeal.jpeg';
import momAndChild from '@images/health/mom_and_child.jpeg';
import elderlyAndNurse from '@images/health/elderly_and_nurse.jpeg';
import washingHands from '@images/health/washinghands.jpeg';
import groupJogging from '@images/health/groupjogging.jpeg';
import fruits from '@images/health/fruits.jpeg';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';

/** The services page in one locale. */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).services;
const articleCopy = copy.articles;

const articles: Article[] = [
  {
    title: articleCopy.guidance.title,
    subTitle: articleCopy.guidance.subTitle,
    images: [
      { src: doctor, alt: articleCopy.guidance.imageAlts[0] },
      { src: groupSession, alt: articleCopy.guidance.imageAlts[1] },
    ],
  },
  {
    title: articleCopy.craftsmanship.title,
    subTitle: articleCopy.craftsmanship.subTitle,
    images: [{ src: healthyMeal, alt: articleCopy.craftsmanship.imageAlts[0] }],
    cta: { title: articleCopy.craftsmanship.cta, url: '/blog' },
  },
  {
    title: articleCopy.oversight.title,
    subTitle: articleCopy.oversight.subTitle,
    images: [
      { src: momAndChild, alt: articleCopy.oversight.imageAlts[0] },
      { src: elderlyAndNurse, alt: articleCopy.oversight.imageAlts[1] },
    ],
  },
  {
    title: articleCopy.maintenance.title,
    subTitle: articleCopy.maintenance.subTitle,
    images: [{ src: washingHands, alt: articleCopy.maintenance.imageAlts[0] }],
  },
  {
    title: articleCopy.bespoke.title,
    subTitle: articleCopy.bespoke.subTitle,
    images: [
      { src: groupJogging, alt: articleCopy.bespoke.imageAlts[0] },
      { src: fruits, alt: articleCopy.bespoke.imageAlts[1] },
    ],
    cta: { title: articleCopy.bespoke.cta, url: '/contact' },
  },
];
---

<MainLayout
  title={copy.title}
  description={copy.metaDescription}
  ogTitle={copy.ogTitle}
>
  <MainSection
    title={copy.intro.title}
    subTitle={copy.intro.subTitle}
    cta={{ title: copy.intro.cta, url: '#' }}
  />
  <AlternatingSections articles={articles} />
  <FeaturesStats
    title={copy.stats.title}
    subTitle={copy.stats.subTitle}
    mainStatTitle={copy.stats.mainStatTitle}
    mainStatSubTitle={copy.stats.mainStatSubTitle}
    stats={copy.stats.stats}
  />
</MainLayout>
