---
import MainLayout from '@/layouts/MainLayout.astro';
import CardRelated from '@components/ui/cards/CardRelated.astro';
import CardArticle from '@components/ui/cards/CardArticle.astro';
import Bookmark from '@components/ui/buttons/Bookmark.astro';
import SocialShare from '@components/ui/buttons/SocialShare.astro';
import PostFeedback from '@components/ui/feedback/PostFeedback.astro';
import { render, type CollectionEntry } from 'astro:content';
import { formatDate } from '@utils/utils';
import { entriesFor, localeOf } from '@utils/content';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';
import { localePath } from '@utils/locale';
import { getPublishedArticles, type Article } from '@/utils/supabase';

interface Props {
  article?: Article | null;
  post?: CollectionEntry<'blog'> | null;
  locale?: MarketingLocale;
}

const { article = null, post = null, locale: propLocale } = Astro.props;

// Determine locale
const locale: MarketingLocale = propLocale || (post ? localeOf(post) : 'sw');
const t = getCopy(locale);

// If markdown post
let markdownContent: any = null;
if (post) {
  const rendered = await render(post);
  markdownContent = rendered.Content;
}

// Meta values
const title = article?.title || post?.data.title || 'Makala ya Afya';
const description = article?.excerpt || post?.data.description || 'HealthTalks makala ya afya na tiba.';
const author = article?.author_name || post?.data.author || 'HealthTalks Team';
const date = article?.created_at ? new Date(article.created_at) : (post?.data.pubDate || new Date());
const formattedDate = formatDate(date, locale);
const categoryName = article?.categories?.name || 'Afya na Ustawi';
const isMedicallyReviewed = article?.medically_reviewed ?? true;
const coverImage = article?.featured_image || (post?.data.cardImage ? (typeof post.data.cardImage === 'string' ? post.data.cardImage : post.data.cardImage.src) : null);

// Related articles
const allPublished = await getPublishedArticles();
const relatedDbArticles = article
  ? allPublished.filter(a => a.id !== article.id).slice(0, 3)
  : allPublished.slice(0, 3);

const relatedPosts = post
  ? (await entriesFor('blog', locale)).filter(blogEntry => blogEntry.id !== post.id)
  : [];
---

<MainLayout
  title={title}
  description={description}
  section={t.blog.ogSection}
  kind={{
    type: 'BlogPosting',
    image: coverImage || '',
    datePublished: date,
    author: author,
  }}
>
  <article class="mx-auto max-w-4xl px-4 pt-8 pb-16 sm:px-6 lg:px-8">
    {/* Breadcrumbs */}
    <nav class="mb-6 flex items-center gap-2 text-xs font-semibold text-text-muted">
      <a href={localePath(locale, '/')} class="hover:text-dark-green transition">Mwanzo</a>
      <span>/</span>
      <a href={localePath(locale, '/blog')} class="hover:text-dark-green transition">Blog & Makala</a>
      <span>/</span>
      <span class="text-accent line-clamp-1">{categoryName}</span>
    </nav>

    {/* Category & Verified Badge Header */}
    <div class="flex flex-wrap items-center gap-2.5 mb-4">
      <span class="rounded-full bg-primary-soft px-3.5 py-1 text-xs font-bold text-dark-green border border-border">
        {categoryName}
      </span>

      {isMedicallyReviewed && (
        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-800 border border-emerald-200">
          <svg class="size-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
            <polyline points="20 6 9 17 4 12" />
          </svg>
          {locale === 'sw' ? 'Imethibitishwa na Daktari Bingwa' : 'Medically Reviewed'}
        </span>
      )}
    </div>

    {/* Article Title */}
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-dark-green leading-[1.18]">
      {title}
    </h1>

    {/* Excerpt / Subtitle */}
    {description && (
      <p class="mt-4 text-lg sm:text-xl text-text-muted leading-relaxed font-normal">
        {description}
      </p>
    )}

    {/* Author & Meta bar */}
    <div class="mt-6 mb-8 flex flex-wrap items-center justify-between gap-4 border-y border-border/80 py-4">
      <div class="flex items-center gap-3">
        <div class="size-11 rounded-full bg-primary-soft text-dark-green border border-border flex items-center justify-center font-bold text-sm shadow-2xs">
          {author.slice(0, 2).toUpperCase()}
        </div>
        <div>
          <div class="text-sm font-bold text-text">{author}</div>
          <div class="flex items-center gap-2 text-xs text-text-muted">
            <span>{formattedDate}</span>
            <span>·</span>
            <span>Dakika 4 kusoma</span>
          </div>
        </div>
      </div>

      {/* Share & Bookmark Actions */}
      <div class="flex items-center gap-2">
        <Bookmark />
        <div class="h-4 w-px bg-border"></div>
        <SocialShare pageTitle={title} />
      </div>
    </div>

    {/* Featured Cover Image */}
    {coverImage && (
      <div class="mb-10 overflow-hidden rounded-3xl border border-border/80 bg-primary-soft/30 shadow-md">
        <img
          src={coverImage}
          alt={title}
          class="w-full max-h-[500px] object-cover object-center"
          loading="eager"
          onerror="this.onerror=null; this.src='/images/healthymeal.jpeg';"
        />
      </div>
    )}

    {/* Article Main Body Content */}
    {article ? (
      <div
        class="medium-article-body prose prose-lg max-w-none text-text"
        set:html={article.content || '<p>Hakuna maudhui yaliyohifadhiwa bado.</p>'}
      />
    ) : (
      markdownContent && (
        <article class="prose prose-lg prose-neutral dark:prose-invert max-w-none text-pretty md:mb-8 font-serif leading-[1.6]">
          {/* @ts-ignore */}
          <markdownContent />
        </article>
      )
    )}

    {/* Feedback Component */}
    <div class="mt-12 border-t border-border/80 pt-8">
      <PostFeedback
        title={t.blog.wasHelpful}
        firstChoice={t.blog.yes}
        secondChoice={t.blog.no}
      />
    </div>
  </article>

  {/* Related Articles Section */}
  <section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 border-t border-border/60 bg-bg/40">
    <div class="mb-8 flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-extrabold text-dark-green">
          {locale === 'sw' ? 'Makala Zingine Zinazohusiana' : t.blog.relatedArticles}
        </h2>
        <p class="text-xs text-text-muted mt-1">Endelea kujifunza kuhusu afya na uzima kupitia makala zetu za kitaalamu.</p>
      </div>

      <a
        href={localePath(locale, '/blog')}
        class="rounded-xl border border-border bg-white px-4 py-2 text-xs font-bold text-dark-green hover:bg-primary-soft transition"
      >
        {locale === 'sw' ? 'Tazama Zote →' : 'View All →'}
      </a>
    </div>

    {relatedDbArticles.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {relatedDbArticles.map(rel => (
          <CardArticle article={rel} locale={locale} />
        ))}
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {relatedPosts.map(entry => (
          <CardRelated blogEntry={entry} />
        ))}
      </div>
    )}
  </section>
</MainLayout>

<style is:global>
  /* Medium-Style Reader Prose Typography */
  .medium-article-body {
    font-family: 'Source Serif 4', Charter, Georgia, 'Times New Roman', serif;
    font-size: 20px;
    line-height: 1.68;
    color: #1F2A1C;
  }

  .medium-article-body p {
    margin-bottom: 1.75rem;
  }

  .medium-article-body h2 {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 1.85rem;
    font-weight: 800;
    color: #2E7D1F;
    margin-top: 3rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .medium-article-body h3 {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 1.45rem;
    font-weight: 700;
    color: #2E7D1F;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .medium-article-body blockquote {
    border-left: 4px solid #2E7D1F;
    padding-left: 1.5rem;
    margin: 2.25rem 0;
    font-style: italic;
    color: #5B6B57;
    font-size: 1.35rem;
    line-height: 1.6;
  }

  .medium-article-body ul {
    list-style-type: disc;
    padding-left: 1.75rem;
    margin-bottom: 1.75rem;
  }

  .medium-article-body ol {
    list-style-type: decimal;
    padding-left: 1.75rem;
    margin-bottom: 1.75rem;
  }

  .medium-article-body li {
    margin-bottom: 0.5rem;
  }

  .medium-article-body img {
    border-radius: 1.25rem;
    border: 1px solid rgba(213, 232, 200, 0.8);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    margin: 2.5rem 0;
    width: 100%;
    display: block;
  }

  .medium-article-body hr {
    border: none;
    border-top: 2px solid #D5E8C8;
    margin: 3rem 0;
  }

  .medium-article-body a {
    color: #4CAF2A;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .medium-article-body pre {
    background-color: #F4FAEE;
    border: 1px solid #D5E8C8;
    border-radius: 1rem;
    padding: 1.25rem;
    font-family: monospace;
    font-size: 0.9rem;
    overflow-x: auto;
    margin: 2rem 0;
  }

  .medium-article-body code:not(pre code) {
    background-color: #F4FAEE;
    border: 1px solid #D5E8C8;
    border-radius: 0.375rem;
    padding: 0.15rem 0.4rem;
    font-family: monospace;
    font-size: 0.85em;
    color: #2E7D1F;
  }
</style>
