---
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import TrendingSection from '@components/sections/landing/TrendingSection.astro';
import FeaturedVideosSection from '@components/sections/landing/FeaturedVideosSection.astro';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import TestimonialsSection from '@components/sections/testimonials/TestimonialsSection.astro';
import PricingSection from '@components/sections/pricing/PricingSection.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import AnnouncementBanner from '@components/ui/banners/AnnouncementBanner.astro';
import heroImage from '@images/health/doctor.jpeg';
import featureImage from '@images/health/groupsession.jpeg';
import nutritionImage from '@images/health/healthymeal.jpeg';
import fitnessImage from '@images/health/groupjogging.jpeg';
import preventiveImage from '@images/health/getiingvaccine.jpeg';
import testimonialAvatar from '@images/health/elderly_and_nurse.jpeg';
import avatar1 from '@images/health/runningwoman.jpeg';
import avatar2 from '@images/health/mom_and_child.jpeg';
import avatar3 from '@images/health/sippingcoffe.jpeg';
import avatar4 from '@images/health/doctor.jpeg';
import gutHealthImage from '@images/health/healthymeal.jpeg';
import womenHealthImage from '@images/health/mom_and_child.jpeg';
import sleepHealthImage from '@images/health/sleepinginanet.jpeg';
import seniorHealthImage from '@images/health/elderly_and_nurse.jpeg';
import dailyWellnessImage from '@images/health/washinghands.jpeg';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';
import { getPublishedArticles } from '@/utils/supabase';

/** The home page in one locale. Copy comes from the locale's copy table. */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const copy = t.home;

const avatarSrcs = [avatar1, avatar2, avatar3, avatar4];

const testimonials = copy.testimonials.quotes.map(quote => ({
  ...quote,
  avatarSrc: testimonialAvatar,
}));

// Fetch real articles from Supabase
const publishedArticles = await getPublishedArticles();
const dbFeatured = publishedArticles[0];
const dbStories = publishedArticles.slice(1, 5);

const featuredStory = dbFeatured
  ? {
      tag: dbFeatured.categories?.name || 'Afya',
      title: dbFeatured.title,
      description: dbFeatured.excerpt || 'Soma makala hii ya kisayansi kuhusu afya na ustawi...',
      author: dbFeatured.author_name || 'HealthTalks Team',
      readTime: 'Dakika 4 kusoma',
      src: dbFeatured.featured_image || gutHealthImage,
      href: localePath(locale, `/blog/${dbFeatured.slug || dbFeatured.id}`),
    }
  : {
      ...copy.trending.featured,
      src: gutHealthImage,
    };

const fallbackImages = [womenHealthImage, sleepHealthImage, seniorHealthImage, dailyWellnessImage];

const trendingStories = dbStories.length > 0
  ? dbStories.map((article, idx) => ({
      tag: article.categories?.name || 'Afya',
      title: article.title,
      readTime: 'Dakika 3 kusoma',
      src: article.featured_image || fallbackImages[idx % fallbackImages.length],
      href: localePath(locale, `/blog/${article.slug || article.id}`),
    }))
  : [
      { ...copy.trending.stories[0], src: womenHealthImage },
      { ...copy.trending.stories[1], src: sleepHealthImage },
      { ...copy.trending.stories[2], src: seniorHealthImage },
      { ...copy.trending.stories[3], src: dailyWellnessImage },
    ];
---

<MainLayout locale={locale}>
  <AnnouncementBanner
    btnId="dismiss-button"
    btnTitle={copy.banner}
    url={localePath(locale, '/blog')}
  />

  <HeroSection
    title={copy.hero.title}
    subTitle={copy.hero.subTitle}
    primaryBtn={copy.hero.primaryBtn}
    primaryBtnURL={localePath(locale, '/blog')}
    secondaryBtn={copy.hero.secondaryBtn}
    secondaryBtnURL={localePath(locale, '/contact')}
    withReview={true}
    avatars={avatarSrcs}
    rating={copy.hero.rating}
    starCount={4}
    reviews={copy.hero.reviews}
    src={heroImage}
    alt={copy.hero.imageAlt}
  />

  <TrendingSection
    locale={locale}
    badge={copy.trending.badge}
    featured={featuredStory}
    stories={trendingStories}
  />

  <FeaturedVideosSection locale={locale} />

  <FeaturesGeneral
    title={copy.featuresGeneral.title}
    subTitle={copy.featuresGeneral.subTitle}
    src={featureImage}
    alt={copy.featuresGeneral.imageAlt}
    features={t.data.features}
  />

  <FeaturesNavs
    title={copy.featuresNavs.title}
    tabs={[
      {
        ...copy.featuresNavs.tabs.tools,
        svg: 'sparks',
        src: nutritionImage,
        first: true,
      },
      {
        ...copy.featuresNavs.tabs.dashboard,
        svg: 'groups',
        src: fitnessImage,
        second: true,
      },
      {
        ...copy.featuresNavs.tabs.features,
        svg: 'verified',
        src: preventiveImage,
      },
    ]}
  />

  <TestimonialsSection
    title={copy.testimonials.title}
    subTitle={copy.testimonials.subTitle}
    testimonials={testimonials}
    statistics={copy.testimonials.statistics}
  />

  <PricingSection pricing={t.data.pricing} />

  <FAQ title={copy.faqTitle} faqs={t.data.faqs} />

  <HeroSectionAlt
    title={copy.heroAlt.title}
    subTitle={copy.heroAlt.subTitle}
    url={localePath(locale, '/blog')}
  />
</MainLayout>
