---
import Meta from '@components/Meta.astro';
import Navbar from '@components/sections/navbar&footer/Navbar.astro';
import FooterSection from '@components/sections/navbar&footer/FooterSection.astro';
import VideoPopupModal from '@components/ui/modals/VideoPopupModal.astro';
import CookieConsentBanner from '@components/ui/banners/CookieConsentBanner.astro';
import NewsletterPopupBanner from '@components/ui/modals/NewsletterPopupBanner.astro';
import { buildPageMetadata, type PageKind } from '@utils/metadata';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';
import '@styles/global.css';

/**
 * Marketing-page layout. A page tells it what the page *is* (title,
 * description, section, kind); the layout derives the whole `<head>` from
 * that via `buildPageMetadata()` and wraps the content in Navbar +
 * FooterSection.
 */
interface Props {
  /** Page title without the site suffix. Omit on the home page. */
  title?: string;
  description?: string;
  ogTitle?: string;
  /** Site section for the OG title, e.g. `copy.blog.ogSection`. */
  section?: string;
  kind?: PageKind;
  hideFooter?: boolean;
  locale?: MarketingLocale;
}

const {
  title,
  description,
  ogTitle,
  section,
  kind,
  hideFooter = false,
  locale: propLocale,
} = Astro.props;
const locale = propLocale ?? Astro.locals.locale ?? 'sw';
const t = getCopy(locale);

const metadata = buildPageMetadata({
  locale,
  pathname: Astro.url.pathname,
  title,
  description,
  ogTitle,
  section,
  kind,
});
---

<html
  lang={metadata.lang}
  class="scrollbar-hide lenis lenis-smooth scroll-pt-16"
>
  <head>
    <Meta metadata={metadata} />
    <script is:inline>
      // HealthTalks brand palette is a crisp, clean light-green theme
      document.documentElement.classList.remove('dark');

      // Safeguard against third-party accessibility keydown undefined key length errors
      window.addEventListener('keydown', (e) => {
        if (!e.key) {
          try { Object.defineProperty(e, 'key', { value: '' }); } catch (_) {}
        }
      }, true);
    </script>
    <script>
      import '@scripts/lenisSmoothScroll.js';
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-bg text-text selection:bg-primary selection:text-text">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-text focus:ring-2 focus:ring-accent"
    >
      {t.layout.skipToContent}
    </a>
    {/*
    Setting up the main structure of the page.
    The Navbar is placed at the top, with a slot for the main content and FooterSection at the bottom.
    */}
    <div class="mx-auto w-full max-w-(--breakpoint-2xl) grow px-4 sm:px-6 lg:px-8">
      <Navbar locale={locale} />
      <main id="main-content">
        <slot />
      </main>
    </div>
    {!hideFooter && <FooterSection locale={locale} />}
    <VideoPopupModal locale={locale} />
    <CookieConsentBanner locale={locale} />
    <NewsletterPopupBanner locale={locale} />
    <script>
      // https://preline.co
      import 'preline';
      const init = () =>
        (
          window as Window & { HSStaticMethods?: { autoInit?: () => void } }
        ).HSStaticMethods?.autoInit?.();
      if (document.readyState === 'loading')
        document.addEventListener('DOMContentLoaded', init);
      else init();
    </script>
    <style>
      /* CSS rules for the page scrollbar */
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }

      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </body>
</html>
