---
// Import necessary modules and utilities
import { Image } from 'astro:assets';
import { formatDate } from '@utils/utils';
import { localeOf, pathFor } from '@utils/content';
import type { CollectionEntry } from 'astro:content';

const { blogEntry } = Astro.props;

interface Props {
  blogEntry: CollectionEntry<'blog'>;
}
---

<a
  class="group block rounded-xl border border-border bg-white p-3 shadow-xs ring-accent outline-hidden transition duration-300 hover:shadow-md focus-visible:ring-2"
  href={pathFor(blogEntry)}
  data-astro-prefetch
>
  <div>
    <Image
      class="aspect-video rounded-lg"
      src={blogEntry.data.cardImage}
      alt={blogEntry.data.cardImageAlt}
      draggable={'false'}
      format={'avif'}
    />
    {/* The title of the blog post */}
    <h3 class="mt-3 text-lg font-bold text-balance text-dark-green group-hover:text-accent transition duration-200">
      {blogEntry.data.title}
    </h3>
    {/* The formatted publication date of the blog post */}
    <p class="mt-2 text-sm text-text-muted">
      {formatDate(blogEntry.data.pubDate, localeOf(blogEntry))}
    </p>
  </div>
</a>
