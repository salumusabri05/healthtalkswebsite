---
import type { Article } from '@/utils/supabase';
import type { MarketingLocale } from '@utils/locale';
import { localePath } from '@utils/locale';

interface Props {
  article: Article;
  locale: MarketingLocale;
}

const { article, locale } = Astro.props;
const articleUrl = localePath(locale, `/blog/${article.slug || article.id}`);

const formattedDate = article.created_at
  ? new Date(article.created_at).toLocaleDateString(locale === 'sw' ? 'sw-TZ' : 'en-US', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    })
  : '';
---

<a
  href={articleUrl}
  class="group flex flex-col overflow-hidden rounded-2xl border border-border bg-white shadow-2xs transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-md"
>
  {/* Card Cover Image */}
  <div class="relative aspect-[16/10] w-full overflow-hidden bg-primary-soft/40">
    {article.featured_image ? (
      <img
        src={article.featured_image}
        alt={article.title}
        class="size-full object-cover object-center transition duration-500 ease-out group-hover:scale-105"
        loading="lazy"
        onerror="this.onerror=null; this.src='/images/healthymeal.jpeg';"
      />
    ) : (
      <div class="flex size-full items-center justify-center bg-gradient-to-br from-primary-soft to-border text-dark-green font-extrabold text-2xl">
        HealthTalks
      </div>
    )}

    {/* Badges Overlay */}
    <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
      <span class="rounded-full bg-white/95 backdrop-blur-xs px-3 py-0.5 text-[11px] font-bold text-dark-green shadow-xs border border-border/80">
        {article.categories?.name || 'Afya'}
      </span>
      {article.medically_reviewed && (
        <span class="rounded-full bg-emerald-600/90 backdrop-blur-xs px-2.5 py-0.5 text-[10px] font-bold text-white shadow-xs">
          ✓ Verified
        </span>
      )}
    </div>
  </div>

  {/* Card Content */}
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="flex items-center gap-2 text-xs font-semibold text-accent">
      <span>{article.categories?.name || 'Afya na Ustawi'}</span>
      {article.is_featured && <span>· ★ Featured</span>}
    </div>

    <h3 class="mt-2 text-lg sm:text-xl font-extrabold tracking-tight text-dark-green transition duration-200 group-hover:text-accent line-clamp-2">
      {article.title}
    </h3>

    {article.excerpt && (
      <p class="mt-2.5 text-sm text-text-muted line-clamp-2 leading-relaxed">
        {article.excerpt}
      </p>
    )}

    <div class="mt-auto pt-4 flex items-center justify-between border-t border-border/60 text-xs font-semibold text-text-muted">
      <div class="flex items-center gap-2">
        <div class="size-6 rounded-full bg-primary-soft text-dark-green flex items-center justify-center font-bold text-[10px] border border-border">
          {article.author_name ? article.author_name.slice(0, 2).toUpperCase() : 'HT'}
        </div>
        <span class="text-text font-bold line-clamp-1">{article.author_name || 'HealthTalks Team'}</span>
      </div>

      <span>{formattedDate}</span>
    </div>
  </div>
</a>

