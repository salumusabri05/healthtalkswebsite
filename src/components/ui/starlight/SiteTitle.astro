---
const main = '/';
const locale = Astro.props.locale ? Astro.props.locale + '/' : '';
const docs = '/' + locale + 'welcome-to-docs/';
---

<span class="site-title flex items-center gap-3">
  <a class="main-logo inline-flex items-center gap-2" href={main} aria-label="HealthTalks">
    <img
      src="/logo.jpg"
      alt="HealthTalks Logo"
      class="h-8 w-8 rounded-lg object-cover ring-1 ring-border"
      width="32"
      height="32"
    />
    <span class="text-lg font-extrabold tracking-tight text-text">
      Health<span class="text-dark-green">Talks</span>
    </span>
  </a>
  <span class="text-neutral-300 dark:text-neutral-600">/</span>
  <a
    class="docs-logo text-sm font-semibold text-text-muted hover:text-dark-green"
    href={docs}
    aria-label="HealthTalks Docs"
  >
    Guides
  </a>
</span>

<style>
  .site-title {
    gap: 0.75rem;
    margin-right: 1rem;
  }
  .site-title a {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .site-title a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
