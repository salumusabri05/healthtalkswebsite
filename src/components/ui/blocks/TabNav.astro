---
// Extract properties from Astro.props
const { aria, dataTab, id, heading, content, first, index = 0 } = Astro.props;

// Define TypeScript interface for properties
interface Props {
  dataTab: string;
  id: string;
  aria: string;
  heading?: string;
  content?: string;
  first?: boolean;
  index?: number;
}

// Clean HealthTalks styling: inactive is light/transparent, active is crisp white card with green accents
const BUTTON_CLASS =
  'tab-nav-btn group relative w-full text-start rounded-2xl p-4 md:p-5 transition-all duration-300 cursor-pointer border border-transparent ' +
  'hover:bg-primary-soft/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent ' +
  'hs-tab-active:bg-white hs-tab-active:shadow-lg hs-tab-active:border-border hs-tab-active:hover:bg-white ' +
  '[&.active]:bg-white [&.active]:shadow-lg [&.active]:border-border [&.active]:hover:bg-white';
---

<button
  type="button"
  class={`${first ? 'active hs-tab-active ' : ''}${BUTTON_CLASS}`}
  id={id}
  data-hs-tab={dataTab}
  data-tab-index={index}
  aria-controls={aria}
  aria-selected={first ? 'true' : 'false'}
  role="tab"
>
  <span class="flex items-start">
    <span class="mt-0.5 shrink-0 transition-colors duration-300 text-accent group-hover:text-dark-green hs-tab-active:text-dark-green [.active_&]:text-dark-green">
      <slot />
    </span>
    <span class="ms-4 grow">
      <span class="block text-base md:text-lg font-bold text-text transition-colors duration-300 hs-tab-active:text-dark-green [.active_&]:text-dark-green">
        {heading}
      </span>
      <span class="mt-1 block text-sm leading-relaxed text-text-muted transition-colors duration-300 hs-tab-active:text-text [.active_&]:text-text">
        {content}
      </span>
    </span>
  </span>
</button>
