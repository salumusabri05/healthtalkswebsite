---
import Icon from './icons/Icon.astro';
import { LOCALE_INFO, MARKETING_LOCALES, alternatePaths, type MarketingLocale } from '@utils/locale';
import { getCopy } from '@/copy';

interface Props {
  locale?: MarketingLocale;
}

const { locale: propLocale } = Astro.props;
const locale = propLocale ?? Astro.locals.locale ?? 'sw';
const t = getCopy(locale);
const alternates = alternatePaths(Astro.url.pathname);
---

<div class="hs-dropdown relative inline-flex">
  <button
    id="hs-dropdown-default"
    type="button"
    aria-label={t.layout.changeLanguage}
    title={t.layout.changeLanguage}
    class="hs-dropdown-toggle inline-flex items-center gap-x-2 rounded-lg px-2 py-1.5 text-sm font-semibold text-text outline-none transition duration-200 hover:bg-primary-soft hover:text-dark-green focus-visible:ring-2 focus-visible:ring-accent"
  >
    <Icon name="earth" class="h-4 w-4 shrink-0 text-accent" />
    <span class="text-xs uppercase font-bold text-dark-green">{locale}</span>
    <Icon name="chevronDown" class="hs-dropdown-open:rotate-180 size-3.5 text-text-muted" />
  </button>

  <div
    class="hs-dropdown-menu duration hs-dropdown-open:opacity-100 top-[98%]! left-[20%]! mt-2 hidden transform-none! rounded-xl border border-border bg-white p-2 opacity-0 shadow-lg transition-[opacity,margin] md:top-[80%]! md:left-[90%]! z-50 min-w-36"
    aria-labelledby="hs-dropdown-default"
  >
    {MARKETING_LOCALES.map(loc => (
      <a
        class={`flex items-center justify-between rounded-lg px-3 py-2 text-sm font-medium transition ${
          loc === locale
            ? 'bg-primary-soft text-dark-green font-bold'
            : 'text-text hover:bg-primary-soft/50 hover:text-dark-green'
        }`}
        href={alternates[loc]}
        hreflang={LOCALE_INFO[loc].lang}
      >
        <span>{LOCALE_INFO[loc].label}</span>
        {loc === locale && <span class="size-1.5 rounded-full bg-dark-green"></span>}
      </a>
    ))}
  </div>
</div>
