---
import Icon from '@components/ui/icons/Icon.astro';

const { title, btnId, btnTitle, url } = Astro.props;
const { copy: t } = Astro.locals;

interface Props {
  title?: string;
  btnId: string;
  btnTitle: string;
  url: string;
}

const storageKey = `banner-dismissed:${btnId}`;
---

<astro-banner btnId={btnId} storageKey={storageKey} class="hidden">
  <div
    class="fixed start-1/2 bottom-0 z-50 mx-auto w-full -translate-x-1/2 transform p-6 sm:max-w-4xl"
    role="region"
    aria-label={t.banner.region}
  >
    <div class="rounded-xl bg-dark-green bg-[url('/banner-pattern.svg')] bg-cover bg-center bg-no-repeat p-4 text-center shadow-lg border border-border/40">
      <div class="flex items-center justify-center">
        <div class="ml-auto">
          {title && (
            <p class="me-2 inline-block font-semibold text-white">
              {title}
            </p>
          )}
          <a
            class="group inline-flex items-center gap-x-2 rounded-full border border-primary bg-primary px-4 py-2 text-sm font-bold text-text shadow-sm transition duration-300 hover:bg-primary-hover focus-visible:ring-2 focus-visible:ring-offset-2"
            href={url}
          >
            {btnTitle}
            <Icon
              name="arrowRight"
              class="size-4 shrink-0 transition duration-300 group-hover:translate-x-1 text-text"
            />
          </a>
        </div>
        <button
          type="button"
          class="ml-auto inline-flex items-center gap-x-2 rounded-full border border-white/20 bg-white/10 p-2 text-sm font-semibold text-white hover:bg-white/20 transition disabled:pointer-events-none disabled:opacity-50"
          id={btnId}
        >
          <span class="sr-only">{t.banner.dismiss}</span>
          <Icon name="close" class="size-5 shrink-0 text-white" />
        </button>
      </div>
    </div>
  </div>
</astro-banner>
<script>
  class AstroBanner extends HTMLElement {
    connectedCallback() {
      const btnId = this.getAttribute('btnId');
      const storageKey = this.getAttribute('storageKey');
      if (storageKey && localStorage.getItem(storageKey) === '1') {
        this.remove();
        return;
      }
      this.classList.remove('hidden');
      const button = btnId ? this.querySelector(`#${btnId}`) : null;
      if (button != null) {
        button.addEventListener('click', () => {
          if (storageKey) localStorage.setItem(storageKey, '1');
          this.remove();
        });
      }
    }
  }

  customElements.define('astro-banner', AstroBanner);
</script>
