---
import Icon from '@components/ui/icons/Icon.astro';
const { title, url } = Astro.props;

interface Props {
  title?: string;
  url?: string;
}

const baseClasses =
  'group inline-flex items-center justify-center gap-x-3 rounded-lg px-6 py-3.5 text-center text-sm font-semibold text-text shadow-sm transition duration-300 outline-hidden';
const borderClasses = 'border border-border';
const bgColorClasses = 'bg-primary hover:bg-primary-hover';
const hoverClasses = 'hover:shadow-md';
const fontSizeClasses = '2xl:text-base';
---

<a
  class={`${baseClasses} ${borderClasses} ${bgColorClasses} ${hoverClasses} ${fontSizeClasses}`}
  href={url}
>
  {title}
  <Icon
    name="arrowRight"
    class="h-4 w-4 shrink-0 text-text transition duration-300 group-hover:translate-x-1"
  />
</a>
