---
import Icon from '@components/ui/icons/Icon.astro';
import type { IconName } from '@components/ui/icons/icons';

const { copy: t } = Astro.locals;
const { pageTitle, title = t.share.share } = Astro.props;

interface Props {
  pageTitle: string;
  title?: string;
}

type SocialPlatform = {
  name: string;
  url: string;
  icon: IconName;
  customColor?: string;
};

// Canonical public URL on healthtalks.co.tz
const rawPath = Astro.url.pathname;
const publicUrl = `https://healthtalks.co.tz${rawPath.endsWith('/') ? rawPath : rawPath + '/'}`;
const encodedUrl = encodeURIComponent(publicUrl);
const encodedTitle = encodeURIComponent(pageTitle);

// WhatsApp message format (Title + Link)
const whatsAppText = encodeURIComponent(`${pageTitle}\n\nSoma makala hii ya afya hapa:\n${publicUrl}`);

const socialPlatforms: SocialPlatform[] = [
  {
    name: 'WhatsApp',
    url: `https://api.whatsapp.com/send?text=${whatsAppText}`,
    icon: 'whatsapp',
    customColor: 'text-[#25D366] hover:bg-[#25D366]/10',
  },
  {
    name: 'Facebook',
    url: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    icon: 'facebook',
  },
  {
    name: 'X (Twitter)',
    url: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
    icon: 'x',
  },
  {
    name: 'LinkedIn',
    url: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}&title=${encodedTitle}`,
    icon: 'linkedIn',
  },
];
---

<div class="hs-dropdown relative inline-flex [--auto-close:inside] [--placement:top-left]">
  <button
    id="hs-dropup"
    type="button"
    class="hs-dropdown-toggle inline-flex items-center gap-x-2 rounded-xl border border-border bg-white px-3.5 py-2 text-xs font-bold text-dark-green transition hover:bg-primary-soft hover:border-accent/40 focus:outline-none cursor-pointer"
  >
    <Icon name="share" class="size-3.5 text-accent" />
    <span>{title}</span>
  </button>

  <div
    class="hs-dropdown-menu duration hs-dropdown-open:opacity-100 z-30 hidden w-72 divide-y divide-border rounded-2xl bg-white p-2 opacity-0 shadow-xl border border-border transition-[opacity,margin]"
    aria-labelledby="hs-dropup"
  >
    {/* Native Web Share button (for mobile WhatsApp/Direct share) */}
    <div class="p-1">
      <button
        type="button"
        id="native-share-btn"
        data-share-title={pageTitle}
        data-share-url={publicUrl}
        class="flex w-full items-center gap-x-3 rounded-xl bg-primary-soft/60 px-3 py-2 text-xs font-bold text-dark-green hover:bg-primary-soft transition cursor-pointer"
      >
        <span class="flex size-6 items-center justify-center rounded-full bg-dark-green text-white">
          <Icon name="whatsapp" class="size-3.5" />
        </span>
        <span>Shiriki Haraka (Share on WhatsApp)</span>
      </button>
    </div>

    {/* Social links */}
    <div class="py-2 space-y-0.5">
      {socialPlatforms.map(platform => (
        <a
          class={`flex items-center gap-x-3 rounded-xl px-3 py-2 text-xs font-semibold text-text hover:bg-primary-soft/40 transition ${platform.customColor || ''}`}
          href={platform.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.share.shareOn(platform.name)}
        >
          <Icon name={platform.icon} class="size-4 shrink-0 text-text-muted" />
          <span>{platform.name}</span>
        </a>
      ))}
    </div>

    {/* Copy Link button */}
    <div class="pt-1.5">
      <button
        type="button"
        class="js-clipboard flex w-full items-center gap-x-3 rounded-xl px-3 py-2 text-xs font-semibold text-text hover:bg-bg transition cursor-pointer"
        data-clipboard-text={publicUrl}
        data-clipboard-success-text={t.share.copied}
      >
        <Icon
          name="clipboard"
          class="js-clipboard-default size-4 text-text-muted transition"
        />
        <Icon
          name="check"
          class="js-clipboard-success hidden size-4 text-dark-green"
        />
        <span class="js-clipboard-success-text">{t.share.copyLink}</span>
      </button>
    </div>
  </div>
</div>

<script>
  import ClipboardJS from 'clipboard';

  // Native share handling (Triggers native WhatsApp/Share sheet on phones)
  const nativeBtn = document.getElementById('native-share-btn');
  nativeBtn?.addEventListener('click', async () => {
    const title = nativeBtn.dataset.shareTitle || document.title;
    const url = nativeBtn.dataset.shareUrl || window.location.href;

    if (navigator.share) {
      try {
        await navigator.share({
          title,
          text: `${title} - HealthTalks`,
          url,
        });
      } catch (err) {
        // Fallback open whatsapp web/app directly
        window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(title + '\n\n' + url)}`, '_blank');
      }
    } else {
      window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(title + '\n\n' + url)}`, '_blank');
    }
  });

  // Initialization of Clipboard
  window.addEventListener('load', () => {
    const clipboards = document.querySelectorAll<HTMLElement>('.js-clipboard');

    clipboards.forEach(el => {
      const clipboard = new ClipboardJS(el, {
        text: () => {
          return el.dataset.clipboardText || window.location.href;
        },
      });

      clipboard.on('success', () => {
        const defaultElement = el.querySelector<HTMLElement>('.js-clipboard-default');
        const successElement = el.querySelector<HTMLElement>('.js-clipboard-success');
        const successTextElement = el.querySelector<HTMLElement>('.js-clipboard-success-text');
        const successText = el.dataset.clipboardSuccessText || 'Imenakiliwa!';
        let oldSuccessText: string | undefined;

        if (successTextElement) {
          oldSuccessText = successTextElement.textContent || '';
          successTextElement.textContent = successText;
        }

        if (defaultElement && successElement) {
          defaultElement.style.display = 'none';
          successElement.style.display = 'block';
        }

        setTimeout(() => {
          if (successTextElement && oldSuccessText !== undefined) {
            successTextElement.textContent = oldSuccessText;
          }

          if (defaultElement && successElement) {
            successElement.style.display = '';
            defaultElement.style.display = '';
          }
        }, 1200);
      });
    });
  });
</script>
