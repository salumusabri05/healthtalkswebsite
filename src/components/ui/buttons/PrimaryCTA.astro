---
import Icon from '@components/ui/icons/Icon.astro';

/**
 * The call-to-action button. Renders an `<a>` when given a `url`, otherwise a
 * `<button>` (give it an `id` to wire a script to it). Any other attribute
 * (`data-astro-prefetch`, `aria-*`, …) is forwarded to the element.
 */
interface Props {
  title?: string;
  url?: string;
  /** `orange` (default) or the yellow brand button. */
  variant?: 'orange' | 'yellow';
  noArrow?: boolean;
  [attribute: string]: unknown;
}

const { title, url, variant = 'orange', noArrow, ...rest } = Astro.props;

const classes = [
  'group inline-flex items-center justify-center gap-x-2 rounded-lg px-4 py-3 text-sm font-bold text-text bg-primary hover:bg-primary-hover active:bg-primary-hover ring-accent transition duration-300 focus-visible:ring-2 outline-hidden shadow-xs',
  'border border-border/60',
  'disabled:pointer-events-none disabled:opacity-50',
  '2xl:text-base',
].join(' ');

const Element = url ? 'a' : 'button';
---

<Element class={classes} href={url} {...rest}>
  {title}
  {noArrow ? null : (
    <Icon
      name="arrowRight"
      class="h-4 w-4 shrink-0 transition duration-300 group-hover:translate-x-1"
    />
  )}
</Element>
