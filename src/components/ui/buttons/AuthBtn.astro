---
// Destructure the properties from Astro.props
const { title } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  title: string;
}
// Define CSS classes for styling the button
const baseClasses =
  'inline-flex w-full items-center justify-center gap-x-2 rounded-lg px-4 py-3 text-sm font-bold text-text bg-primary hover:bg-primary-hover ring-accent focus-visible:ring-2 outline-hidden transition duration-300 shadow-xs';
const borderClasses = 'border border-border/60';
const fontSizeClasses = '2xl:text-base';
const disabledClasses = 'disabled:pointer-events-none disabled:opacity-50';
---

{/* Styled submit button with dynamic title */}
<button
  type="submit"
  class={`${baseClasses} ${borderClasses} ${fontSizeClasses} ${disabledClasses}`}
>
  {title}
</button>
