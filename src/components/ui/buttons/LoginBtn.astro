---
import Icon from '@components/ui/icons/Icon.astro';

const { title = Astro.locals.copy.auth.logIn } = Astro.props;

interface Props {
  title?: string;
}

const baseClasses =
  'flex items-center gap-x-2 text-base md:text-sm font-medium text-text ring-accent transition duration-300 focus-visible:ring-2 outline-hidden';
const hoverClasses = 'hover:text-dark-green';
const mdClasses = 'md:my-6 md:border-s md:border-border md:ps-6';
const txtSizeClasses = '2xl:text-base';
---

<button
  type="button"
  class={`${baseClasses} ${hoverClasses} ${mdClasses} ${txtSizeClasses}`}
  data-hs-overlay="#hs-toggle-between-modals-login-modal"
>
  <Icon name="user" class="h-4 w-4 shrink-0 text-accent" />
  {title}
</button>
