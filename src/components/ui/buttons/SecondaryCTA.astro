---
// Destructure the properties from Astro.props
const { title, url } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  title?: string;
  url?: string;
}
// Define CSS classes for the hyperlink button
const baseClasses =
  'inline-flex items-center justify-center gap-x-2 rounded-lg px-4 py-3 text-center text-sm font-bold text-white bg-dark-green shadow-xs outline-hidden ring-accent focus-visible:ring-2 transition duration-300';
const borderClasses = 'border border-transparent';
const hoverClasses = 'hover:bg-[#256619] hover:text-white active:bg-[#1e5214]';
const disableClasses = 'disabled:pointer-events-none disabled:opacity-50';
const fontSizeClasses = '2xl:text-base';
---

{/* Styled hyperlink */}
<a
  class={`${baseClasses} ${borderClasses} ${hoverClasses} ${disableClasses} ${fontSizeClasses}`}
  href={url}
>
  {title}
</a>
