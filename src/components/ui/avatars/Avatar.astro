---
import { Image } from 'astro:assets';

const { src, alt, loading = 'lazy' } = Astro.props;

interface Props {
  src: any;
  alt: string;
  loading?: 'lazy' | 'eager';
}
---

{
  typeof src === 'string' && src.startsWith('http') ? (
    <img
      class="inline-block size-8 shrink-0 rounded-full object-cover ring-2 ring-neutral-50 dark:ring-zinc-800"
      src={src}
      alt={alt}
      width="32"
      height="32"
      loading={loading}
      decoding="async"
    />
  ) : (
    <Image
      class="inline-block size-8 shrink-0 rounded-full object-cover ring-2 ring-neutral-50 dark:ring-zinc-800"
      src={src}
      alt={alt}
      width={32}
      height={32}
      loading={loading}
      decoding="async"
    />
  )
}
