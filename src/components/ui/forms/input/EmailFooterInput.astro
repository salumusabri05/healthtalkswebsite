---
const { copy: t } = Astro.locals;
const {
  label = t.forms.email,
  title = t.forms.subscribe,
  id = 'footer-input',
} = Astro.props;

interface Props {
  label?: string;
  title?: string;
  id?: string;
}
---

<div class="mt-4 flex flex-col items-center gap-2 rounded-lg bg-white/10 p-2 sm:flex-row sm:gap-3 border border-border/30">
  <div class="w-full">
    <label for={id} class="sr-only">
      {label}
    </label>
    <input
      type="email"
      id={id}
      name="email"
      required
      autocomplete="email"
      class="block w-full rounded-lg border border-border bg-white px-4 py-3 text-sm text-text placeholder:text-text-muted caret-accent focus:border-accent focus:ring-accent disabled:pointer-events-none disabled:opacity-50"
      placeholder={t.forms.emailPlaceholder}
    />
  </div>
  <button
    type="submit"
    class="inline-flex w-full items-center justify-center gap-x-2 rounded-lg border border-transparent bg-primary p-3 text-sm font-bold whitespace-nowrap text-text ring-accent outline-hidden transition duration-300 hover:bg-primary-hover focus-visible:ring-2 disabled:pointer-events-none disabled:opacity-50 sm:w-auto"
  >
    {title}
  </button>
</div>
