---
interface Props {
  isEditing?: boolean;
}

const { isEditing = false } = Astro.props;
---

<header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-border/40">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4 sm:px-6">
    {/* Left: Back Arrow & HealthTalks Logo */}
    <div class="flex items-center gap-3">
      <a
        href="/admin/articles"
        title="Rudi kwenye Makala zote (Back to articles)"
        class="flex size-9 items-center justify-center rounded-full text-text-muted transition hover:bg-bg hover:text-dark-green"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m15 18-6-6 6-6" />
        </svg>
      </a>

      <a href="/admin" class="flex items-center gap-2">
        <img src="/logo.jpg" alt="HealthTalks Logo" class="size-7 rounded-full object-cover border border-border" />
        <span class="text-sm font-extrabold tracking-tight text-dark-green hidden sm:inline">HealthTalks</span>
      </a>

      <span class="rounded-full bg-primary-soft/80 px-2.5 py-0.5 text-[11px] font-bold text-dark-green hidden md:inline">
        {isEditing ? 'Hariri Makala' : 'Rasimu Mpya'}
      </span>
    </div>

    {/* Right: Autosave Status, Publish Button, User Avatar */}
    <div class="flex items-center gap-4">
      {/* Save Status Indicator */}
      <div id="save-status" class="flex items-center gap-1.5 text-xs font-semibold text-text-muted">
        <span class="size-2 rounded-full bg-emerald-500"></span>
        <span id="save-status-text">Draft saved</span>
      </div>

      {/* Publish CTA Button */}
      <button
        type="button"
        id="open-publish-modal-btn"
        class="rounded-full bg-dark-green px-4 py-1.5 text-xs font-bold text-white shadow-xs transition hover:bg-accent focus:outline-none focus:ring-2 focus:ring-accent/20 cursor-pointer"
      >
        Publish
      </button>

      {/* User Avatar */}
      <div class="size-8 rounded-full bg-primary-soft text-dark-green border border-border flex items-center justify-center font-bold text-xs">
        HT
      </div>
    </div>
  </div>
</header>

