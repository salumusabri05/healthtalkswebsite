<svg {...Astro.props} viewBox="0 0 260 60" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Health / Conversation Pulse Icon -->
  <g class="brand-icon">
    <!-- Rounded conversation badge -->
    <rect
      x="4"
      y="6"
      width="48"
      height="48"
      rx="14"
      class="fill-yellow-500/15 dark:fill-yellow-400/20 stroke-yellow-500 dark:stroke-yellow-400"
      stroke-width="2.5"
    />
    <!-- ECG / Heartbeat pulse line -->
    <path
      d="M12 30h7l4-9 6 18 5-12 4 5h8"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-yellow-500 dark:text-yellow-400"
    />
  </g>

  <!-- HealthTalks Typography -->
  <text
    x="64"
    y="39"
    font-family="system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
    font-size="28"
    font-weight="800"
    letter-spacing="-0.5"
  >
    <tspan class="fill-neutral-900 dark:fill-white">Health</tspan><tspan class="fill-yellow-500 dark:fill-yellow-400">Talks</tspan>
  </text>
</svg>
