---
interface Props {
  class?: string;
  isInFooter?: boolean;
}

const { class: className = '', isInFooter = false } = Astro.props;
---

<div class={`inline-flex items-center gap-2.5 ${className}`}>
  <img
    src="/logo.jpg"
    alt="HealthTalks Logo"
    class="h-9 w-9 shrink-0 rounded-xl object-cover ring-1 ring-border/60 shadow-xs"
    width="36"
    height="36"
    loading="eager"
  />
  <span class={`text-xl font-extrabold tracking-tight whitespace-nowrap ${isInFooter ? 'text-white' : 'text-text'}`}>
    Health<span class={isInFooter ? 'text-primary' : 'text-dark-green'}>Talks</span>
  </span>
</div>
