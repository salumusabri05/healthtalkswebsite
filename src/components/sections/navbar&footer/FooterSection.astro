---
import FooterSocialLink from '@components/ui/links/FooterSocialLink.astro';
import EmailFooterInput from '@components/ui/forms/input/EmailFooterInput.astro';
import DemoForm from '@components/ui/forms/DemoForm.astro';
import Icon from '@components/ui/icons/Icon.astro';
import BrandLogo from '@components/BrandLogo.astro';
import { SITE } from '@data/constants';
import { footerSections, socialLinks } from '@data/navigation';
import { localePath, type MarketingLocale } from '@utils/locale';
import { getCopy } from '@/copy';

interface Props {
  locale?: MarketingLocale;
}

const { locale: propLocale } = Astro.props;
const locale = propLocale ?? Astro.locals.locale ?? 'sw';
const t = getCopy(locale);
const footer = t.nav.footer;
---

<footer class="w-full bg-dark-green text-white">
  <div class="mx-auto w-full max-w-[85rem] px-4 py-10 sm:px-6 lg:px-16 lg:pt-20 2xl:max-w-(--breakpoint-2xl)">
    <div class="grid grid-cols-2 gap-6 md:grid-cols-4 lg:grid-cols-5">
      <div class="col-span-full lg:col-span-1">
        {/* Brand Logo */}
        <BrandLogo class="h-auto" isInFooter={true} />
      </div>
      {/* Link sections from the copy table (Ecosystem, Company, …) */}
      {footerSections.map(section => (
        <div class="col-span-1">
          <h3 class="font-bold text-white">
            {footer.sectionTitles[section.id]}
          </h3>
          <ul class="mt-3 grid space-y-3">
            {section.links.map(link => (
              <li>
                <a
                  href={localePath(locale, link.path)}
                  class="inline-flex gap-x-2 rounded-lg text-white/80 ring-accent outline-hidden transition duration-300 hover:text-white focus-visible:ring-2"
                >
                  {footer.links[link.id]}
                </a>
                {link.badge === 'hiring' ? (
                  <span class="ms-1 inline rounded-lg bg-primary px-2 py-1 text-xs font-bold text-text">
                    {footer.hiringBadge}
                  </span>
                ) : null}
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="col-span-2">
        <h3 class="font-bold text-white">
          {footer.stayUpToDate}
        </h3>

        <DemoForm successMessage={footer.newsletterDemoMessage}>
          <EmailFooterInput />
          <p class="mt-3 text-sm text-white/80">
            {footer.stayUpToDateContent}
          </p>
        </DemoForm>
      </div>
    </div>

    <div class="mt-9 grid gap-y-2 sm:mt-12 sm:flex sm:items-center sm:justify-between sm:gap-y-0">
      <div class="flex items-center justify-between">
        <p class="text-sm text-white/80">
          © <span id="current-year"></span>
          {` `}
          {SITE.title}. {footer.craftedBy}
          {` `}
          <a
            class="rounded-lg font-medium text-white underline underline-offset-2 ring-accent outline-hidden transition duration-300 hover:text-primary focus-visible:ring-2"
            href="https://healthtalks.org"
            target="_blank"
            rel="noopener noreferrer"
          >
            HealthTalks
          </a>
          .
        </p>
      </div>

      {/* Social Brands */}
      <div>
        <FooterSocialLink url={socialLinks.facebook} label="Facebook">
          <Icon name="facebook" class="h-4 w-4 shrink-0 text-white hover:text-primary" title="Facebook" />
        </FooterSocialLink>

        <FooterSocialLink url={socialLinks.x} label="X">
          <Icon name="x" class="h-4 w-4 shrink-0 text-white hover:text-primary" title="X" />
        </FooterSocialLink>

        <FooterSocialLink url={socialLinks.github} label="GitHub">
          <Icon name="githubMark" class="h-4 w-4 shrink-0 text-white hover:text-primary" title="GitHub" />
        </FooterSocialLink>

        <FooterSocialLink url={socialLinks.google} label="Google">
          <Icon name="google" class="h-4 w-4 shrink-0 text-white hover:text-primary" title="Google" />
        </FooterSocialLink>

        <FooterSocialLink url={socialLinks.slack} label="Slack">
          <Icon name="slack" class="h-4 w-4 shrink-0 text-white hover:text-primary" title="Slack" />
        </FooterSocialLink>
      </div>
    </div>

    <script>
      const year = new Date().getFullYear();
      const element = document.getElementById('current-year');
      element!.innerText = year.toString();
    </script>
  </div>
</footer>
